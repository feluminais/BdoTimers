<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- Release pdbs go inside the assemblies: none ship loose, and logged stack traces keep their line numbers. WiX
       projects read DebugType as their own pdb format, so only C# projects get it. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(MSBuildProjectExtension)' == '.csproj'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
