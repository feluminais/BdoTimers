<UserControl x:Class="BdoTimers.App.Views.UpcomingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ListView ItemsSource="{Binding Rows}" BorderThickness="0">
        <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Muted}" Value="True">
                        <Setter Property="Opacity" Value="0.45" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ListView.ItemContainerStyle>
        <ListView.View>
            <GridView>
                <GridViewColumn Header="Timer" Width="200" DisplayMemberBinding="{Binding Name}" />
                <GridViewColumn Header="When" Width="110" DisplayMemberBinding="{Binding When}" />
                <GridViewColumn Header="In" Width="100">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Countdown}" FontFamily="Consolas" />
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="90">
                    <GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding MuteLabel}" Command="{Binding ToggleMuteCommand}" Padding="8,1"
                                    ToolTip="Skip alerts for this one occurrence" />
                        </DataTemplate>
                    </GridViewColumn.CellTemplate>
                </GridViewColumn>
            </GridView>
        </ListView.View>
    </ListView>
</UserControl>
