<UserControl x:Class="BdoTimers.App.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BdoTimers.App.Views">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" AutomationProperties.Name="Following"
                    Command="{Binding OpenFollowingCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE716;" Style="{StaticResource IconText}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="Following" />
                </StackPanel>
            </Button>
            <TextBlock Text="Schedule" Style="{StaticResource DisplayText}" FontSize="18" VerticalAlignment="Center" />
            <Border Margin="18,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="2" CornerRadius="7" BorderThickness="1"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource HairlineBrush}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="WeekToggle" Style="{StaticResource SegmentButton}" GroupName="ScheduleMode" Content="Week" IsChecked="True" />
                    <RadioButton x:Name="MonthToggle" Style="{StaticResource SegmentButton}" GroupName="ScheduleMode" Content="Month" />
                </StackPanel>
            </Border>
        </DockPanel>
        <Grid>
            <views:BossesView DataContext="{Binding Week}"
                              Visibility="{Binding IsChecked, ElementName=WeekToggle, Converter={StaticResource BoolToVisibility}}" />
            <views:CalendarView DataContext="{Binding Month}"
                                Visibility="{Binding IsChecked, ElementName=MonthToggle, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DockPanel>
</UserControl>
