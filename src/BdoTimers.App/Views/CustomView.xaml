<UserControl x:Class="BdoTimers.App.Views.CustomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BdoTimers.App.Controls"
             xmlns:vm="clr-namespace:BdoTimers.App.ViewModels">
    <UserControl.Resources>
        <!-- Two-digit field of the start picker; the wheel and the arrow keys step it -->
        <Style x:Key="ClockBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="{StaticResource ClockFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="Width" Value="48" />
            <Setter Property="MaxLength" Value="2" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <EventSetter Event="PreviewMouseWheel" Handler="ClockBox_PreviewMouseWheel" />
            <EventSetter Event="PreviewKeyDown" Handler="ClockBox_PreviewKeyDown" />
            <EventSetter Event="GotKeyboardFocus" Handler="ClockBox_GotKeyboardFocus" />
        </Style>

        <!-- Farm's growth: a green line over a hairline, like the start picker's slider -->
        <Style x:Key="GrowthBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="2" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{DynamicResource HairlineStrongBrush}" />
                            <Border x:Name="PART_Indicator" Background="{DynamicResource GoodBrush}" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A card is one button: an indigo tile whose hairline brightens on hover; keyboard focus uses the shared adorner -->
        <Style x:Key="TimerCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <controls:ClippingBorder x:Name="Card" CornerRadius="8" BorderThickness="1"
                                                 Background="{DynamicResource IndigoCardBrush}" BorderBrush="{DynamicResource IndigoLineBrush}">
                            <ContentPresenter />
                        </controls:ClippingBorder>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource IndigoLineHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Started earlier and the menu stay out of sight until the card is hovered or has the keyboard, its start is being
             picked or its menu is open. Tab still reaches them, and that reveals them. -->
        <Style x:Key="RailButton" TargetType="ButtonBase" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="IsHitTestVisible" Value="True" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="IsHitTestVisible" Value="True" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPickingStart}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="IsHitTestVisible" Value="True" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="IsHitTestVisible" Value="True" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The clock is the text colour while a timer runs and the secondary one while it waits -->
        <Style x:Key="CardClock" TargetType="TextBlock" BasedOn="{StaticResource ClockText}">
            <Setter Property="FontSize" Value="32" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource PastBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource GoodBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource AmberBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One menu for the card's right click and its ⋯ button -->
        <ContextMenu x:Key="TimerMenu" x:Shared="False">
            <MenuItem Header="Stop" Command="{Binding ResetCommand}" Visibility="{Binding HasControls, Converter={StaticResource BoolToVisibility}}" />
            <MenuItem Header="{Binding SkipLabel}" Command="{Binding ToggleSkipNextCommand}"
                      Visibility="{Binding HasNextOccurrence, Converter={StaticResource BoolToVisibility}}" />
        </ContextMenu>

        <DataTemplate DataType="{x:Type vm:TimerTileViewModel}">
            <Grid>
                <Button Style="{StaticResource TimerCard}" Height="108" Margin="0,0,12,12" Command="{Binding OpenCommand}"
                        AutomationProperties.Name="{Binding Name}" ContextMenu="{StaticResource TimerMenu}"
                        ContextMenuService.IsEnabled="{Binding HasMore}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <controls:ArtImage Sources="{Binding Images}" />
                        <!-- Text hugs the right edge of its column, in the black the picture fades into -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0,2,0" TextBlock.TextAlignment="Right">
                            <!-- A preset whose use isn't obvious has an (i) beside its name; the negative margin keeps the padded
                                 hover area from making the line taller -->
                            <DockPanel HorizontalAlignment="Right">
                                <Border DockPanel.Dock="Right" Background="Transparent" Padding="5,4,2,4" Margin="0,-4" VerticalAlignment="Center"
                                        ToolTip="{Binding Info}" ToolTipService.InitialShowDelay="0"
                                        Visibility="{Binding Info, Converter={StaticResource NullToCollapsed}}">
                                    <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" FontSize="11" Foreground="{DynamicResource SubtleBrush}" />
                                </Border>
                                <Ellipse DockPanel.Dock="Left" Style="{StaticResource StatusDot}"
                                         Visibility="{Binding HasControls, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Name}" Style="{StaticResource DisplayText}" FontSize="12" Foreground="{DynamicResource SubtleBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <!-- Shrinks to fit a narrow card rather than lose its last digits -->
                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Digits}" Style="{StaticResource CardClock}" />
                            </Viewbox>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource LabelText}" TextTrimming="CharacterEllipsis" />
                            <!-- As wide as the lines above; the number's fixed width keeps the line from shifting as it grows -->
                            <DockPanel Margin="0,3,0,0" Visibility="{Binding Growth, Converter={StaticResource NullToCollapsed}}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Growth, StringFormat='{}{0} %'}" Style="{StaticResource LabelText}"
                                           Typography.NumeralAlignment="Tabular" Width="34" VerticalAlignment="Center" />
                                <ProgressBar Style="{StaticResource GrowthBar}" Maximum="200" Value="{Binding Growth, TargetNullValue=0, Mode=OneWay}"
                                             VerticalAlignment="Center" AutomationProperties.Name="Growth" />
                            </DockPanel>
                        </StackPanel>
                        <!-- The round Start / Pause is always there; Started earlier above it and the menu below appear on hover -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Button x:Name="StartedButton" Style="{StaticResource RailButton}" VerticalAlignment="Bottom" Margin="0,0,0,2" Content="&#xE823;"
                                    ToolTip="Started earlier" Command="{Binding PickStartCommand}"
                                    Visibility="{Binding HasControls, Converter={StaticResource BoolToVisibility}}" />
                            <Button Grid.Row="1" Style="{StaticResource TimerPlayButton}" Content="{Binding PlayPauseGlyph}" ToolTip="{Binding PlayPauseTip}"
                                    Command="{Binding StartPauseCommand}" Visibility="{Binding HasControls, Converter={StaticResource BoolToVisibility}}" />
                            <Button Grid.Row="1" Style="{StaticResource TimerPlayButton}" Content="&#xE768;" ToolTip="{Binding HorseStartTip}"
                                    Command="{Binding StartHorseRegistrationCommand}" IsEnabled="{Binding CanStartHorse}"
                                    Visibility="{Binding IsHorseTemplate, Converter={StaticResource BoolToVisibility}}" />
                            <Button Grid.Row="2" Style="{StaticResource RailButton}" VerticalAlignment="Top" Margin="0,2,0,0" Content="&#xE712;" ToolTip="More"
                                    ContextMenu="{StaticResource TimerMenu}" Click="More_Click"
                                    Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Grid>
                </Button>

                <!-- Outside the tile's button, so clicks in it never open the timer panel -->
                <Popup IsOpen="{Binding IsPickingStart}" StaysOpen="False" PlacementTarget="{Binding ElementName=StartedButton}"
                       Placement="Left" HorizontalOffset="-6" AllowsTransparency="True" Opened="StartPicker_Opened">
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1" Padding="16,6,16,14"
                            LayoutTransform="{DynamicResource UiScaleTransform}">
                        <Border.InputBindings>
                            <KeyBinding Key="Escape" Command="{Binding CancelStartCommand}" />
                            <KeyBinding Key="Enter" Command="{Binding ConfirmStartCommand}" />
                        </Border.InputBindings>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <StackPanel>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE70E;" FontSize="10" Height="22" ToolTip="Later hour" Command="{Binding HourUpCommand}" />
                                    <TextBox Text="{Binding StartHour, UpdateSourceTrigger=PropertyChanged}" Tag="Hour" Style="{StaticResource ClockBox}"
                                             controls:Ui.HasError="{Binding StartInvalid}" AutomationProperties.Name="Start hour" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="10" Height="22" ToolTip="Earlier hour" Command="{Binding HourDownCommand}" />
                                </StackPanel>
                                <TextBlock Text=":" Style="{StaticResource ClockText}" FontSize="26" VerticalAlignment="Center" Margin="4,0,4,4" />
                                <StackPanel>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE70E;" FontSize="10" Height="22" ToolTip="Later minute" Command="{Binding MinuteUpCommand}" />
                                    <TextBox Text="{Binding StartMinute, UpdateSourceTrigger=PropertyChanged}" Tag="Minute" Style="{StaticResource ClockBox}"
                                             controls:Ui.HasError="{Binding StartInvalid}" AutomationProperties.Name="Start minute" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="10" Height="22" ToolTip="Earlier minute" Command="{Binding MinuteDownCommand}" />
                                </StackPanel>
                            </StackPanel>
                            <!-- Countdowns only: how far along it is, on a line like the game's growth bar; the wheel steps it too -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0"
                                        Visibility="{Binding HasPercent, Converter={StaticResource BoolToVisibility}}">
                                <Slider Width="128" Minimum="0" Maximum="{Binding MaxStartPercent}" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding StartPercent}" VerticalAlignment="Center" PreviewMouseWheel="PercentSlider_PreviewMouseWheel"
                                        AutomationProperties.Name="Percent done" />
                                <!-- Fixed width, so the line doesn't shift as the number grows -->
                                <TextBlock Text="{Binding StartPercent, StringFormat='{}{0} %'}" Style="{StaticResource ClockText}" FontSize="15" Width="46"
                                           Margin="8,0,0,0" TextAlignment="Right" VerticalAlignment="Center" />
                                <!-- The padded, filled border is the hover area; the glyph alone is too small a target -->
                                <Border Background="Transparent" Padding="6,4,2,4" VerticalAlignment="Center" ToolTipService.InitialShowDelay="0"
                                        ToolTip="Growth from My Gardens. If your gardens differ, use the lowest.">
                                    <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" FontSize="12" Foreground="{DynamicResource SubtleBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding StartProblem}" Style="{StaticResource ErrorText}" HorizontalAlignment="Center" TextAlignment="Center"
                                       MaxWidth="160" />
                            <Button Style="{StaticResource OutlineButton}" Content="Start" HorizontalAlignment="Center" Margin="0,8,0,0"
                                    Command="{Binding ConfirmStartCommand}" AutomationProperties.Name="Start from this time" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="New timer"
                    Command="{Binding NewTimerCommand}">
                <StackPanel Orientation="Horizontal">
                    <controls:PlusIcon Size="10" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="New timer" />
                </StackPanel>
            </Button>
            <TextBlock Text="Timers" Style="{StaticResource DisplayText}" FontSize="18" VerticalAlignment="Center" />
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,-12,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
