<UserControl x:Class="BdoTimers.App.Views.CustomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BdoTimers.App.Controls"
             xmlns:vm="clr-namespace:BdoTimers.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Height" Value="100" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{StaticResource BgBrush}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" ClipToBounds="True">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentSoftBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentSoftBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Two-digit field of the start picker; the wheel and the arrow keys step it -->
        <Style x:Key="ClockBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="{StaticResource ClockFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="Width" Value="48" />
            <Setter Property="MaxLength" Value="2" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <EventSetter Event="PreviewMouseWheel" Handler="ClockBox_PreviewMouseWheel" />
            <EventSetter Event="PreviewKeyDown" Handler="ClockBox_PreviewKeyDown" />
            <EventSetter Event="GotKeyboardFocus" Handler="ClockBox_GotKeyboardFocus" />
        </Style>

        <!-- Farm's growth: a gold line over a hairline, like the start picker's slider -->
        <Style x:Key="GrowthBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="2" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{StaticResource HairlineStrongBrush}" />
                            <Border x:Name="PART_Indicator" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type vm:TimerTileViewModel}">
            <Grid>
                <Button Style="{StaticResource TileButton}" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}"
                        ContextMenuService.IsEnabled="{Binding IsWeekly}">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{Binding SkipLabel}" Command="{Binding ToggleSkipNextCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <controls:ArtImage Sources="{Binding Images}" />
                        <!-- Text hugs the right edge, in the black the picture fades into -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0,8,0" TextBlock.TextAlignment="Right">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                            <Setter Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource DisplayText}" FontSize="12" Foreground="{StaticResource SubtleBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Digits}" Style="{StaticResource ClockText}" FontSize="27" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource LabelText}" />
                            <!-- As wide as the lines above; the number's fixed width keeps the line from shifting as it grows -->
                            <DockPanel Margin="0,3,0,0" Visibility="{Binding Growth, Converter={StaticResource NullToCollapsed}}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Growth, StringFormat='{}{0} %'}" Style="{StaticResource LabelText}"
                                           Typography.NumeralAlignment="Tabular" Width="34" VerticalAlignment="Center" />
                                <ProgressBar Style="{StaticResource GrowthBar}" Value="{Binding Growth, TargetNullValue=0, Mode=OneWay}"
                                             VerticalAlignment="Center" AutomationProperties.Name="Growth" />
                            </DockPanel>
                        </StackPanel>
                        <!-- Countdown and stopwatch controls appear while the tile is hovered or focused, and stay while picking a start -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasControls}" Value="True" />
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasControls}" Value="True" />
                                                <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Button}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding IsPickingStart}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Style="{StaticResource IconButton}" Height="30" Content="{Binding PlayPauseGlyph}" FontSize="15"
                                    Foreground="{StaticResource AccentBrush}" ToolTip="{Binding PlayPauseTip}" Command="{Binding StartPauseCommand}" />
                            <Button x:Name="StartedButton" Style="{StaticResource IconButton}" Height="30" Content="&#xE823;"
                                    ToolTip="Started earlier" Command="{Binding PickStartCommand}" />
                            <!-- A drawn square: the icon font's stop glyph sits off-centre next to the others -->
                            <Button Style="{StaticResource IconButton}" Height="30" ToolTip="Stop" Command="{Binding ResetCommand}">
                                <Rectangle Width="9" Height="9" StrokeThickness="1.2" SnapsToDevicePixels="True"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Outside the tile's button, so clicks in it never open the timer panel -->
                <Popup IsOpen="{Binding IsPickingStart}" StaysOpen="False" PlacementTarget="{Binding ElementName=StartedButton}"
                       Placement="Left" HorizontalOffset="-6" AllowsTransparency="True" Opened="StartPicker_Opened">
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentSoftBrush}" BorderThickness="1" Padding="16,6,16,14">
                        <Border.InputBindings>
                            <KeyBinding Key="Escape" Command="{Binding CancelStartCommand}" />
                            <KeyBinding Key="Enter" Command="{Binding ConfirmStartCommand}" />
                        </Border.InputBindings>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <StackPanel>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE70E;" FontSize="10" Height="22" ToolTip="Later hour" Command="{Binding HourUpCommand}" />
                                    <TextBox Text="{Binding StartHour, UpdateSourceTrigger=PropertyChanged}" Tag="Hour" Style="{StaticResource ClockBox}"
                                             controls:Ui.HasError="{Binding StartInvalid}" AutomationProperties.Name="Start hour" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="10" Height="22" ToolTip="Earlier hour" Command="{Binding HourDownCommand}" />
                                </StackPanel>
                                <TextBlock Text=":" Style="{StaticResource ClockText}" FontSize="26" VerticalAlignment="Center" Margin="4,0,4,4" />
                                <StackPanel>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE70E;" FontSize="10" Height="22" ToolTip="Later minute" Command="{Binding MinuteUpCommand}" />
                                    <TextBox Text="{Binding StartMinute, UpdateSourceTrigger=PropertyChanged}" Tag="Minute" Style="{StaticResource ClockBox}"
                                             controls:Ui.HasError="{Binding StartInvalid}" AutomationProperties.Name="Start minute" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="10" Height="22" ToolTip="Earlier minute" Command="{Binding MinuteDownCommand}" />
                                </StackPanel>
                            </StackPanel>
                            <!-- Countdowns only: how far along it is, on a line like the game's growth bar; the wheel steps it too -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0"
                                        Visibility="{Binding HasPercent, Converter={StaticResource BoolToVisibility}}">
                                <Slider Width="128" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding StartPercent}" VerticalAlignment="Center" PreviewMouseWheel="PercentSlider_PreviewMouseWheel"
                                        AutomationProperties.Name="Percent done" />
                                <!-- Fixed width, so the line doesn't shift as the number grows -->
                                <TextBlock Text="{Binding StartPercent, StringFormat='{}{0} %'}" Style="{StaticResource ClockText}" FontSize="15" Width="46"
                                           Margin="8,0,0,0" TextAlignment="Right" VerticalAlignment="Center" />
                                <!-- The padded, filled border is the hover area; the glyph alone is too small a target -->
                                <Border Background="Transparent" Padding="6,4,2,4" VerticalAlignment="Center" ToolTipService.InitialShowDelay="0"
                                        ToolTip="Growth from My Gardens. If your gardens differ, use the lowest.">
                                    <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" FontSize="12" Foreground="{StaticResource SubtleBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding StartProblem}" Style="{StaticResource ErrorText}" HorizontalAlignment="Center" TextAlignment="Center"
                                       MaxWidth="160" />
                            <Button Style="{StaticResource OutlineButton}" Content="Start" HorizontalAlignment="Center" Margin="0,8,0,0"
                                    Command="{Binding ConfirmStartCommand}" AutomationProperties.Name="Start from this time" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CustomViewModel}">
            <Button Style="{StaticResource TileButton}" BorderBrush="Transparent" Command="{Binding NewTimerCommand}"
                    AutomationProperties.Name="Create a new timer">
                <Grid>
                    <Rectangle Stroke="{StaticResource HairlineStrongBrush}" StrokeThickness="1" StrokeDashArray="4 3" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="New timer" Style="{StaticResource DisplayText}" FontSize="12" Foreground="{StaticResource SubtleBrush}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,-10,0" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
