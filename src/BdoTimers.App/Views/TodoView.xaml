<UserControl x:Class="BdoTimers.App.Views.TodoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BdoTimers.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="TodoOpenButton" TargetType="Button" BasedOn="{StaticResource NameButton}" />
        <Style x:Key="TodoCheck" TargetType="CheckBox">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Hit" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" BorderBrush="{DynamicResource SubtleBrush}"
                                    BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="Mark" FontSize="10" Text="" FontWeight="Bold"
                                           Foreground="{DynamicResource OnBronzeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GoodBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Text" Value="✓" />
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource GoodBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GoodBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="Mark" Property="Text" Value="−" />
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource GoodBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GoodBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TodoRowText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStruck}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PastBrush}" />
                    <Setter Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A list's progress: a green line over a hairline -->
        <Style x:Key="TodoProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="2" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{DynamicResource ForestLineStrongBrush}" />
                            <Border x:Name="PART_Indicator" Background="{DynamicResource GoodBrush}" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate DataType="{x:Type vm:TodoRowViewModel}">
            <StackPanel>
                <DockPanel MinHeight="26" Margin="0,2,0,2" LastChildFill="True">
                    <CheckBox DockPanel.Dock="Left" Style="{StaticResource TodoCheck}" IsThreeState="True"
                              IsChecked="{Binding Checked, Mode=OneWay}" IsEnabled="{Binding Enabled}"
                              Command="{Binding ToggleCommand}" Tag="{Binding Id}"
                              AutomationProperties.Name="{Binding AutomationName}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding PartialProgress}" FontSize="11" Margin="6,4,0,0"
                               Foreground="{DynamicResource SubtleBrush}" />
                    <Button Style="{StaticResource TodoOpenButton}" Command="{Binding OpenCommand}" HorizontalContentAlignment="Left"
                            AutomationProperties.Name="{Binding AutomationName}">
                        <TextBlock Text="{Binding Text}" Style="{StaticResource TodoRowText}" Margin="6,4,0,2" />
                    </Button>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Children}" Margin="24,0,0,0" />
            </StackPanel>
        </DataTemplate>
        <!-- A list that is on: its rows under a name, its count and a progress line; the card opens the editor -->
        <DataTemplate x:Key="TodoListCard">
            <Border x:Name="Card" Background="{DynamicResource ForestCardBrush}" BorderBrush="{DynamicResource ForestLineBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14,12,14,8" Margin="0,0,0,12" Cursor="Hand" MouseLeftButtonUp="List_MouseLeftButtonUp">
                <StackPanel>
                    <DockPanel Margin="0,0,0,9">
                        <Button x:Name="More" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24" Content="&#xE712;"
                                ToolTip="Edit list" Command="{Binding OpenCommand}" Opacity="0" IsHitTestVisible="False" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Foreground="{DynamicResource GoodBrush}" FontSize="12"
                                   Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" Margin="10,0,6,0" />
                        <Button Style="{StaticResource TodoOpenButton}" Command="{Binding OpenCommand}"
                                HorizontalAlignment="Left" AutomationProperties.Name="{Binding Name}">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource DisplayText}" FontSize="14"
                                       TextTrimming="CharacterEllipsis" />
                        </Button>
                    </DockPanel>
                    <ProgressBar Style="{StaticResource TodoProgress}" Value="{Binding Fraction, Mode=OneWay}" Margin="0,0,0,8"
                                 AutomationProperties.Name="Progress" />
                    <ItemsControl ItemsSource="{Binding Rows}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ForestLineHoverBrush}" />
                    <Setter TargetName="More" Property="Opacity" Value="1" />
                    <Setter TargetName="More" Property="IsHitTestVisible" Value="True" />
                </Trigger>
                <Trigger SourceName="Card" Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="More" Property="Opacity" Value="1" />
                    <Setter TargetName="More" Property="IsHitTestVisible" Value="True" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A list that is off: one dashed row, with the switch that turns it on -->
        <DataTemplate x:Key="TodoOffRow">
            <Grid Margin="0,0,0,12">
                <Rectangle Stroke="{DynamicResource ForestLineStrongBrush}" StrokeThickness="1" StrokeDashArray="4 3" RadiusX="8" RadiusY="8" />
                <DockPanel Margin="14,8,12,8" TextElement.Foreground="{DynamicResource SubtleBrush}">
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource OnOffSwitch}" Width="36" IsChecked="{Binding IsOn, Mode=TwoWay}"
                                  AutomationProperties.Name="{Binding Name, StringFormat='Active {0}'}" />
                    <TextBlock DockPanel.Dock="Right" Text="Off" FontSize="12" VerticalAlignment="Center" Margin="10,0,10,0" />
                    <Button Style="{StaticResource TodoOpenButton}" Command="{Binding OpenCommand}" HorizontalAlignment="Left" VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding Name}">
                        <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                    </Button>
                </DockPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,8,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24" Content="&#xE710;" FontSize="13"
                        ToolTip="New weekly list" Command="{Binding NewWeeklyCommand}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding WeeklyResetLabel}" Style="{StaticResource LabelText}"
                           VerticalAlignment="Center" Margin="4,0,8,0" />
                <TextBlock Text="Weekly" Style="{StaticResource DisplayText}" FontSize="19" VerticalAlignment="Center" />
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <ItemsControl ItemsSource="{Binding WeeklyOn}" ItemTemplate="{StaticResource TodoListCard}" />
                    <ItemsControl ItemsSource="{Binding WeeklyOff}" ItemTemplate="{StaticResource TodoOffRow}" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
        <DockPanel Grid.Column="2">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24" Content="&#xE710;" FontSize="13"
                        ToolTip="New daily list" Command="{Binding NewDailyCommand}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding DailyResetLabel}" Style="{StaticResource LabelText}"
                           VerticalAlignment="Center" Margin="4,0,8,0" />
                <TextBlock Text="Daily" Style="{StaticResource DisplayText}" FontSize="19" VerticalAlignment="Center" />
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding DailyOn}" ItemTemplate="{StaticResource TodoListCard}" />
                    <ItemsControl ItemsSource="{Binding DailyOff}" ItemTemplate="{StaticResource TodoOffRow}" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
