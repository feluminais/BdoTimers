<UserControl x:Class="BdoTimers.App.Views.TodoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BdoTimers.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="TodoOpenButton" TargetType="Button" BasedOn="{StaticResource NameButton}" />
        <Style x:Key="TodoCheck" TargetType="CheckBox">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Hit" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <Border x:Name="Box" Width="14" Height="14" BorderBrush="{DynamicResource SubtleBrush}"
                                    BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="Mark" FontSize="11" Text="" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Text" Value="✓" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="Mark" Property="Text" Value="−" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TodoRowText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStruck}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PastBrush}" />
                    <Setter Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TodoActiveToggle" TargetType="ToggleButton" BasedOn="{StaticResource Chip}">
            <Setter Property="Content" Value="Off" />
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="On" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate DataType="{x:Type vm:TodoRowViewModel}">
            <StackPanel>
                <DockPanel MinHeight="26" Margin="0,2,0,2" LastChildFill="True">
                    <CheckBox DockPanel.Dock="Left" Style="{StaticResource TodoCheck}" IsThreeState="True"
                              IsChecked="{Binding Checked, Mode=OneWay}" IsEnabled="{Binding Enabled}"
                              Command="{Binding ToggleCommand}" Tag="{Binding Id}"
                              AutomationProperties.Name="{Binding AutomationName}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding PartialProgress}" FontSize="11" Margin="6,4,0,0"
                               Foreground="{DynamicResource SubtleBrush}" />
                    <Button Style="{StaticResource TodoOpenButton}" Command="{Binding OpenCommand}" HorizontalContentAlignment="Left"
                            AutomationProperties.Name="{Binding AutomationName}">
                        <TextBlock Text="{Binding Text}" Style="{StaticResource TodoRowText}" Margin="6,4,0,2" />
                    </Button>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Children}" Margin="24,0,0,0" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TodoListCardViewModel}">
            <Border Background="Transparent" BorderThickness="0,1,0,0"
                    Padding="0,9,0,16" MouseLeftButtonUp="List_MouseLeftButtonUp" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource AccentBrush}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Visibility="{Binding IsOn, Converter={StaticResource BoolToVisibility}}" />
                            <ToggleButton Style="{StaticResource TodoActiveToggle}" IsChecked="{Binding IsOn, Mode=TwoWay}"
                                          AutomationProperties.Name="{Binding Name, StringFormat='Active {0}'}" />
                        </StackPanel>
                        <Button Style="{StaticResource TodoOpenButton}" Command="{Binding OpenCommand}"
                                HorizontalAlignment="Left" AutomationProperties.Name="{Binding Name}">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource DisplayText}" FontSize="15"
                                       TextTrimming="CharacterEllipsis" />
                        </Button>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Rows}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,8,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;" FontSize="16"
                        ToolTip="New weekly list" Command="{Binding NewWeeklyCommand}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding WeeklyResetLabel}" Style="{StaticResource LabelText}"
                           VerticalAlignment="Center" Margin="4,0,6,0" />
                <TextBlock Text="Weekly" Style="{StaticResource DisplayText}" FontSize="21" VerticalAlignment="Center" />
            </DockPanel>
            <Border DockPanel.Dock="Top" Height="1" Margin="0,0,8,0" Background="{DynamicResource HairlineBrush}"
                    Visibility="{Binding HasItems, ElementName=WeeklyLists, Converter={StaticResource InverseBoolToVisibility}}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="WeeklyLists" ItemsSource="{Binding Weekly}" Margin="0,0,8,0" />
            </ScrollViewer>
        </DockPanel>
        <DockPanel Grid.Column="2">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;" FontSize="16"
                        ToolTip="New daily list" Command="{Binding NewDailyCommand}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding DailyResetLabel}" Style="{StaticResource LabelText}"
                           VerticalAlignment="Center" Margin="4,0,6,0" />
                <TextBlock Text="Daily" Style="{StaticResource DisplayText}" FontSize="21" VerticalAlignment="Center" />
            </DockPanel>
            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource HairlineBrush}"
                    Visibility="{Binding HasItems, ElementName=DailyLists, Converter={StaticResource InverseBoolToVisibility}}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="DailyLists" ItemsSource="{Binding Daily}" />
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
