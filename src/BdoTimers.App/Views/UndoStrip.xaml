<UserControl x:Class="BdoTimers.App.Views.UndoStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}">
  <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource PanelBrush}" Padding="22,8">
    <DockPanel LastChildFill="False">
      <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"
                 AutomationProperties.LiveSetting="Polite" />
      <Button Content="Undo" Command="{Binding UndoCommand}" Style="{StaticResource LinkButton}" Margin="14,0,0,0" ToolTip="Ctrl+Z" />
      <Button Content="&#xE8BB;" Command="{Binding DismissCommand}" Style="{StaticResource IconButton}" DockPanel.Dock="Right"
              AutomationProperties.Name="Dismiss undo" ToolTip="Dismiss" />
    </DockPanel>
  </Border>
</UserControl>
