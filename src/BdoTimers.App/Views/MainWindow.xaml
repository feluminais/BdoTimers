<Window x:Class="BdoTimers.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BdoTimers.App.Views"
        xmlns:controls="clr-namespace:BdoTimers.App.Controls"
        Title="BDO Timers" Width="960" Height="720" MinWidth="640" MinHeight="360"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" controls:Ui.TrackKeyboardFocus="True">
    <WindowChrome.WindowChrome>
        <!-- GlassFrameThickness 0,0,0,1 keeps the system drop shadow on a frameless window. -->
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6,3,6,6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border x:Name="Frame" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
        <Grid>
          <Grid x:Name="MainContent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top bar: the empty area drags the window -->
            <Grid Margin="22,0,0,0" Height="44" LayoutTransform="{DynamicResource UiScaleTransform}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- The app icon in its small-size form: one gold diamond with an hourglass in it -->
                    <Viewbox Width="30" Height="30" Margin="0,0,7,0" IsHitTestVisible="False">
                        <Canvas Width="64" Height="64">
                            <Path Data="M32,7 L57,32 L32,57 L7,32 Z" Stroke="{DynamicResource AccentBrush}" StrokeThickness="4" />
                            <Path Data="M25,20 L39,20 L32,32 L39,44 L25,44 L32,32 Z" Fill="{DynamicResource AccentTextBrush}" />
                        </Canvas>
                    </Viewbox>
                    <RadioButton x:Name="TodayTab" Style="{StaticResource TabButton}" controls:Ui.SectionBrush="{DynamicResource AccentBrush}" IsChecked="True" Tag="Today"
                                 AutomationProperties.Name="Today" Checked="Tab_Checked" WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource TabDot}" />
                            <TextBlock Text="Today" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ScheduleTab" Style="{StaticResource TabButton}" controls:Ui.SectionBrush="{DynamicResource AccentTextBrush}" Tag="Schedule"
                                 AutomationProperties.Name="Schedule" Checked="Tab_Checked" WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource TabDot}" />
                            <TextBlock Text="Schedule" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="CustomTab" Style="{StaticResource TabButton}" controls:Ui.SectionBrush="{DynamicResource TimersAccentBrush}" Tag="Timers"
                                 AutomationProperties.Name="Timers" Checked="Tab_Checked" WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource TabDot}" />
                            <TextBlock Text="Timers" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TodoTab" Style="{StaticResource TabButton}" controls:Ui.SectionBrush="{DynamicResource GoodBrush}" Tag="Todo"
                                 AutomationProperties.Name="To-do" Checked="Tab_Checked" WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource TabDot}" />
                            <TextBlock Text="To-do" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <!-- The room between the tabs and the buttons, which the next boss takes, trimmed to fit -->
                <Grid x:Name="ChipHost" Grid.Column="1" SizeChanged="ChipHost_SizeChanged">
                    <!-- The next boss, on every screen but Today; a click goes to Today -->
                    <Button x:Name="NextChip" Style="{StaticResource NextChip}" Visibility="Collapsed" HorizontalAlignment="Right"
                            DataContext="{Binding Today.Hero}" Command="{Binding DataContext.ShowTodayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            AutomationProperties.Name="{Binding NamesText, StringFormat='Next boss {0}'}" WindowChrome.IsHitTestVisibleInChrome="True">
                        <DockPanel>
                            <controls:ClippingBorder DockPanel.Dock="Left" Width="20" Height="20" CornerRadius="10" Margin="0,0,8,0">
                                <controls:FocusImage Picture="{Binding Next.Images[0]}" />
                            </controls:ClippingBorder>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Next.Clock}" Style="{StaticResource NextChipClock}" />
                            <TextBlock Text="{Binding NamesText}" Style="{StaticResource DisplayText}" FontSize="12" Margin="0,0,10,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Button>
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Shown when the window is wide enough for it beside the tabs and the buttons -->
                    <StackPanel x:Name="PausedBlock" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="{Binding PausedText}" Foreground="{DynamicResource AmberBrush}" FontSize="12" VerticalAlignment="Center" />
                        <Button Style="{StaticResource LinkButton}" Content="Resume" Height="44" Padding="10,0,14,0" Command="{Binding ResumeCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                    </StackPanel>
                    <Button x:Name="BellButton" Style="{StaticResource BellButton}" ToolTip="Alerts" AutomationProperties.Name="Alerts"
                            Click="Bell_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Pause alerts for 1 hour" Command="{Binding PauseHourCommand}" />
                                <MenuItem Header="Pause alerts until resumed" Command="{Binding PauseUntilResumedCommand}" />
                                <Separator />
                                <MenuItem Header="Resume alerts" Command="{Binding ResumeCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Grid>
                            <TextBlock Text="&#xEA8F;" Style="{StaticResource IconText}" FontSize="14" />
                            <Line X1="0" Y1="15" X2="15" Y2="0" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Button>
                    <Grid>
                        <Button Style="{StaticResource GearButton}" Content="&#xE713;" FontSize="13" ToolTip="Settings"
                                AutomationProperties.Name="Settings"
                                Command="{Binding OpenSettingsCommand}" WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource UpdateBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,12,11,0" IsHitTestVisible="False"
                                 Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize"
                            AutomationProperties.Name="Minimize"
                            Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximize"
                            AutomationProperties.Name="Maximize" Click="Maximize_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Close"
                            AutomationProperties.Name="Close"
                            Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>
            <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource HairlineBrush}" />

            <Grid Grid.Row="1" x:Name="ScreenContent" LayoutTransform="{DynamicResource UiScaleTransform}">
              <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <!-- Sized to the viewport, so each screen's own list scrolls under its pinned header;
                   the whole screen scrolls only when the window is smaller than the minimum size. -->
              <ScrollViewer x:Name="ScreenScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
               <Grid Width="{Binding ViewportWidth, ElementName=ScreenScroller}" Height="{Binding ViewportHeight, ElementName=ScreenScroller}"
                     MinWidth="640" MinHeight="300">
               <Grid Margin="22,18,22,20">
                <views:TodayView x:Name="TodayScreen" DataContext="{Binding Today}"
                                 Visibility="{Binding IsChecked, ElementName=TodayTab, Converter={StaticResource BoolToVisibility}}" />
                <views:ScheduleView x:Name="ScheduleScreen" DataContext="{Binding Schedule}"
                                    Visibility="{Binding IsChecked, ElementName=ScheduleTab, Converter={StaticResource BoolToVisibility}}" />
                <views:CustomView x:Name="CustomScreen" DataContext="{Binding Custom}"
                                  Visibility="{Binding IsChecked, ElementName=CustomTab, Converter={StaticResource BoolToVisibility}}" />
                <views:TodoView x:Name="TodoScreen" DataContext="{Binding Todo}"
                                Visibility="{Binding IsChecked, ElementName=TodoTab, Converter={StaticResource BoolToVisibility}}" />
               </Grid>
               </Grid>
              </ScrollViewer>
              <views:UndoStrip Grid.Row="1" DataContext="{Binding Undo}" />
            </Grid>
          </Grid>

            <!-- Panel layer: a drawer from the right edge, or a centred sheet, over a scrim; the panel can't be moved -->
            <Grid x:Name="PanelLayer" Visibility="Collapsed" WindowChrome.IsHitTestVisibleInChrome="True"
                  SizeChanged="PanelLayer_SizeChanged">
                <Border x:Name="Scrim" Background="{DynamicResource DimBrush}" Opacity="0" MouseLeftButtonDown="Dim_MouseLeftButtonDown" />
                <!-- Laid out in unscaled units under the UI scale, so MainWindow.xaml.cs caps it to the window. -->
                <Border x:Name="PanelFrame" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource HairlineStrongBrush}"
                        LayoutTransform="{DynamicResource UiScaleTransform}">
                    <Border.RenderTransform><TranslateTransform x:Name="FrameShift" /></Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Width" Value="440" />
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                            <Setter Property="BorderThickness" Value="1,0,0,0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PanelPresentation}" Value="Sheet">
                                    <Setter Property="Width" Value="760" />
                                    <Setter Property="Height" Value="560" />
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="BorderThickness" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ContentControl x:Name="PanelContent" Focusable="False">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Saving.IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                                        <DataTrigger Binding="{Binding AskingDiscard}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                        <StackPanel Grid.Row="1" Margin="22,0,22,12">
                            <ProgressBar Height="3" IsIndeterminate="{Binding Saving.IsBusy}"
                                         Visibility="{Binding Saving.IsBusy, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Saving" />
                            <TextBlock Text="{Binding Saving.Error}" Style="{StaticResource ErrorText}"
                                       Visibility="{Binding Saving.Error, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                        <Border Grid.RowSpan="2" Background="{DynamicResource PanelBrush}" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding AskingDiscard, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Discard changes?" Style="{StaticResource RowLabel}" />
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Content="Keep editing" Style="{StaticResource OutlineButton}" Command="{Binding KeepEditingCommand}" />
                                    <Button Content="Discard" Style="{StaticResource DangerLinkButton}" Margin="16,0,0,0" Command="{Binding DiscardChangesCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
