<Window x:Class="BdoTimers.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BdoTimers.App.Views"
        xmlns:controls="clr-namespace:BdoTimers.App.Controls"
        xmlns:panels="clr-namespace:BdoTimers.App.Views.Panels"
        xmlns:pvm="clr-namespace:BdoTimers.App.ViewModels.Panels"
        Title="BDO Timers" Width="960" Height="720" MinWidth="640" MinHeight="360"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" controls:Ui.TrackKeyboardFocus="True">
    <WindowChrome.WindowChrome>
        <!-- GlassFrameThickness 0,0,0,1 keeps the system drop shadow on a frameless window. -->
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate DataType="{x:Type pvm:OverlayPanelViewModel}"><panels:OverlayPanel /></DataTemplate>
        <DataTemplate DataType="{x:Type pvm:SettingsPanelViewModel}"><panels:SettingsPanel /></DataTemplate>
        <DataTemplate DataType="{x:Type pvm:UpdatePanelViewModel}"><panels:UpdatePanel /></DataTemplate>
        <DataTemplate DataType="{x:Type pvm:BossPanelViewModel}"><panels:BossPanel /></DataTemplate>
        <DataTemplate DataType="{x:Type pvm:CustomPanelViewModel}"><panels:CustomPanel /></DataTemplate>
        <DataTemplate DataType="{x:Type pvm:NewTimerPanelViewModel}"><panels:NewTimerPanel /></DataTemplate>
        <DataTemplate DataType="{x:Type pvm:TodoListPanelViewModel}"><panels:TodoListPanel /></DataTemplate>
    </Window.Resources>

    <Border x:Name="Frame" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
        <Grid>
          <Grid x:Name="MainContent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top bar: the empty area drags the window -->
            <Grid Margin="22,0,0,0" Height="40" LayoutTransform="{DynamicResource UiScaleTransform}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="BossesTab" Style="{StaticResource TabButton}" Content="Bosses" IsChecked="True"
                                 WindowChrome.IsHitTestVisibleInChrome="True" />
                    <RadioButton x:Name="CustomTab" Style="{StaticResource TabButton}" Content="Timers"
                                 WindowChrome.IsHitTestVisibleInChrome="True" />
                    <RadioButton x:Name="TodoTab" Style="{StaticResource TabButton}" Content="To-do"
                                 WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                                Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding PausedText}" Foreground="{DynamicResource AccentTextBrush}" FontSize="12" VerticalAlignment="Center" />
                        <Button Style="{StaticResource LinkButton}" Content="Resume" Margin="10,0,0,0" Command="{Binding ResumeCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                    </StackPanel>
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE895;" FontSize="15" Foreground="{DynamicResource UpdateBrush}"
                            ToolTip="Update available" AutomationProperties.Name="Update available"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding OpenUpdateDetailsCommand}" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE7F4;" FontSize="13" ToolTip="Overlay"
                            AutomationProperties.Name="Overlay"
                            Command="{Binding OpenOverlaySettingsCommand}" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE713;" FontSize="13" ToolTip="Settings"
                            AutomationProperties.Name="Settings"
                            Command="{Binding OpenSettingsCommand}" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize"
                            AutomationProperties.Name="Minimize"
                            Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximize"
                            AutomationProperties.Name="Maximize" Click="Maximize_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Close"
                            AutomationProperties.Name="Close"
                            Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>
            <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource HairlineBrush}" />

            <Grid Grid.Row="1" x:Name="ScreenContent" LayoutTransform="{DynamicResource UiScaleTransform}">
              <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <!-- Sized to the viewport, so each screen's own list scrolls under its pinned header;
                   the whole screen scrolls only when the window is smaller than the minimum size. -->
              <ScrollViewer x:Name="ScreenScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
               <Grid Width="{Binding ViewportWidth, ElementName=ScreenScroller}" Height="{Binding ViewportHeight, ElementName=ScreenScroller}"
                     MinWidth="640" MinHeight="300">
               <Grid Margin="22,18,22,20">
                <views:BossesView DataContext="{Binding Bosses}"
                                  Visibility="{Binding IsChecked, ElementName=BossesTab, Converter={StaticResource BoolToVisibility}}" />
                <views:CustomView DataContext="{Binding Custom}"
                                  Visibility="{Binding IsChecked, ElementName=CustomTab, Converter={StaticResource BoolToVisibility}}" />
                <views:TodoView DataContext="{Binding Todo}"
                                Visibility="{Binding IsChecked, ElementName=TodoTab, Converter={StaticResource BoolToVisibility}}" />
               </Grid>
               </Grid>
              </ScrollViewer>
              <views:UndoStrip Grid.Row="1" DataContext="{Binding Undo}" />
            </Grid>
          </Grid>

            <!-- Panel layer: dims the whole window and centres one panel; the panel itself can't be moved -->
            <Grid x:Name="PanelLayer" Visibility="Collapsed" Opacity="0" WindowChrome.IsHitTestVisibleInChrome="True">
                <Border Background="{DynamicResource DimBrush}" MouseLeftButtonDown="Dim_MouseLeftButtonDown" />
                <!-- A tall panel is held to the viewport, so its own list scrolls between its header and Done;
                     the layer scrolls only when the viewport is shorter than the minimum height. -->
                <ScrollViewer x:Name="PanelScroller" Margin="16,24" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              Focusable="False" LayoutTransform="{DynamicResource UiScaleTransform}"
                              MouseLeftButtonDown="PanelScroller_MouseLeftButtonDown">
                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxHeight="{Binding ViewportHeight, ElementName=PanelScroller, Converter={StaticResource AtLeast}, ConverterParameter=300}">
                    <ContentControl x:Name="PanelContent" Focusable="False" />
                </Border>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
