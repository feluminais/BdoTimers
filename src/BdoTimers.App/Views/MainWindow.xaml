<Window x:Class="BdoTimers.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BdoTimers.App.Views"
        xmlns:panels="clr-namespace:BdoTimers.App.Views.Panels"
        xmlns:pvm="clr-namespace:BdoTimers.App.ViewModels.Panels"
        Title="BDO Timers" Width="960" Height="720" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <WindowChrome.WindowChrome>
        <!-- GlassFrameThickness 0,0,0,1 keeps the system drop shadow on a frameless window. -->
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding ClosePanelCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <DataTemplate DataType="{x:Type pvm:OverlayPanelViewModel}"><panels:OverlayPanel /></DataTemplate>
        <DataTemplate DataType="{x:Type pvm:SettingsPanelViewModel}"><panels:SettingsPanel /></DataTemplate>
        <DataTemplate DataType="{x:Type pvm:BossPanelViewModel}"><panels:BossPanel /></DataTemplate>
        <DataTemplate DataType="{x:Type pvm:CustomPanelViewModel}"><panels:CustomPanel /></DataTemplate>
        <DataTemplate DataType="{x:Type pvm:NewTimerPanelViewModel}"><panels:NewTimerPanel /></DataTemplate>
    </Window.Resources>

    <Border x:Name="Frame" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top bar: the empty area drags the window -->
            <Grid Margin="22,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource TabButton}" Content="Bosses" IsChecked="{Binding IsBossesSection}"
                                 WindowChrome.IsHitTestVisibleInChrome="True" />
                    <RadioButton Style="{StaticResource TabButton}" Content="Timers" IsChecked="{Binding IsCustomSection}"
                                 WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                                Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding PausedText}" Foreground="{StaticResource AccentTextBrush}" FontSize="12" VerticalAlignment="Center" />
                        <Button Style="{StaticResource LinkButton}" Content="Resume" Margin="10,0,0,0" Command="{Binding ResumeCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True" />
                    </StackPanel>
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE7F4;" FontSize="13" ToolTip="Overlay"
                            AutomationProperties.Name="Overlay"
                            Command="{Binding OpenOverlaySettingsCommand}" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE713;" FontSize="13" ToolTip="Settings"
                            Command="{Binding OpenSettingsCommand}" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize"
                            Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Hide to tray"
                            Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>
            <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource HairlineBrush}" />

            <Grid Grid.Row="1" Margin="22,18,22,20">
                <views:BossesView DataContext="{Binding Bosses}"
                                  Visibility="{Binding DataContext.IsBossesSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                <views:CustomView DataContext="{Binding Custom}"
                                  Visibility="{Binding DataContext.IsCustomSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- Panel layer: dims the whole window and centres one panel; the panel itself can't be moved -->
            <Grid x:Name="PanelLayer" Grid.RowSpan="2" Visibility="Collapsed" Opacity="0">
                <Border Background="{StaticResource DimBrush}" MouseLeftButtonDown="Dim_MouseLeftButtonDown" />
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentSoftBrush}" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24">
                    <ContentControl x:Name="PanelContent" Focusable="False" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
