<Window x:Class="BdoTimers.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BDO Timers" Width="600" Height="640" MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
            <Border DockPanel.Dock="Left" Background="#FFF4E5" BorderBrush="#E0A040" BorderThickness="1"
                    Padding="8,4" CornerRadius="4"
                    Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding PausedText}" VerticalAlignment="Center" />
                    <Button Content="Resume" Margin="8,0,0,0" Padding="8,1" Command="{Binding ResumeCommand}" />
                </StackPanel>
            </Border>
        </DockPanel>
        <TabControl x:Name="Tabs" />
    </DockPanel>
</Window>
