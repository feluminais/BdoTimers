<UserControl x:Class="BdoTimers.App.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BdoTimers.App.ViewModels">
    <UserControl.Resources>
        <!-- An item's text, coloured by its state as in the Bosses week grid -->
        <Style x:Key="StateText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Past">
                    <Setter Property="Foreground" Value="{DynamicResource PastBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Unfollowed">
                    <Setter Property="Foreground" Value="{DynamicResource PastBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Skipped">
                    <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
                    <Setter Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Next">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A day of the month: a card, today filled, the chosen day gold-outlined, other months' days dimmed -->
        <Style x:Key="DayButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="6,4" ClipToBounds="True">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentFillBrush}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding InMonth}" Value="False">
                    <Setter Property="Opacity" Value="0.38" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type vm:CalendarDayViewModel}">
            <Button Style="{StaticResource DayButton}" Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding AutomationName}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- A gold dot: the next boss spawn is on this day -->
                        <Ellipse Width="5" Height="5" Margin="0,0,6,0" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                 ToolTip="Next boss spawn" Visibility="{Binding IsNext, Converter={StaticResource BoolToVisibility}}" />
                        <!-- The cell's largest text, muted so the day doesn't outshine the items under it -->
                        <TextBlock Text="{Binding Number}" FontSize="16">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DisplayText}">
                                    <Setter Property="Foreground" Value="{DynamicResource PastBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Lines}" Margin="0,2,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CalendarLine}">
                                <DockPanel ToolTip="{Binding Time}">
                                    <Ellipse DockPanel.Dock="Left" Width="5" Height="5" Margin="0,0,5,0" VerticalAlignment="Center"
                                             Fill="{Binding Foreground, ElementName=LineName}" />
                                    <TextBlock x:Name="LineName" Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource StateText}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding More}" FontSize="11" Foreground="{DynamicResource SubtleBrush}"
                               Visibility="{Binding More, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock Text="{Binding BossSummary}" FontSize="11" Foreground="{DynamicResource SubtleBrush}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding BossSummary, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- A row of the chosen day: the whole row opens the boss or timer -->
        <DataTemplate DataType="{x:Type vm:CalendarRowViewModel}">
            <Button Style="{StaticResource NameButton}" Command="{Binding OpenCommand}" HorizontalAlignment="Stretch" Padding="0,5"
                    IsHitTestVisible="{Binding CanOpen}" Focusable="{Binding CanOpen}" ToolTip="{Binding Tooltip}"
                    ContextMenuService.IsEnabled="{Binding CanSkip}" AutomationProperties.Name="{Binding Name}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding SkipLabel}" Command="{Binding ToggleSkipCommand}" />
                    </ContextMenu>
                </Button.ContextMenu>
                <DockPanel>
                    <TextBlock Text="{Binding Time}" Width="48" DockPanel.Dock="Left" Style="{StaticResource ClockText}" FontWeight="Normal"
                               FontSize="12" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Detail}" DockPanel.Dock="Right" Style="{StaticResource LabelText}" VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Style="{StaticResource StateText}" />
                </DockPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="250" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE76B;" FontSize="11" ToolTip="Previous month"
                            AutomationProperties.Name="Previous month" Command="{Binding PreviousMonthCommand}" />
                    <TextBlock Text="{Binding Title}" Style="{StaticResource DisplayText}" FontSize="20" Width="200" TextAlignment="Center"
                               VerticalAlignment="Center" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE76C;" FontSize="11" ToolTip="Next month"
                            AutomationProperties.Name="Next month" Command="{Binding NextMonthCommand}" />
                    <Button Style="{StaticResource LinkButton}" Content="Today" Margin="12,0,0,0" VerticalAlignment="Center"
                            Command="{Binding GoToTodayCommand}" />
                </StackPanel>
                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,5,0,0">
                    <ToggleButton Style="{StaticResource Chip}" Content="Bosses" IsChecked="{Binding ShowBosses}" />
                    <ToggleButton Style="{StaticResource Chip}" Content="Timers" IsChecked="{Binding ShowTimers}"
                                  ToolTip="Weekly timers and running countdowns" />
                    <ToggleButton Style="{StaticResource Chip}" Content="Events" IsChecked="{Binding ShowEvents}" />
                    <ToggleButton Style="{StaticResource Chip}" Content="Resets" IsChecked="{Binding ShowResets}"
                                  ToolTip="Daily and weekly to-do resets" />
                </WrapPanel>
            </DockPanel>

            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding WeekDays}" Focusable="False" Margin="0,0,0,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource DisplayText}" FontSize="12" Foreground="{DynamicResource SubtleBrush}"
                                   HorizontalAlignment="Center" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Days}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="6" Columns="7" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DockPanel>

        <DockPanel Grid.Column="2">
            <DockPanel DockPanel.Dock="Top" Margin="0,4,0,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="New event" FontSize="12" Padding="12,4"
                        VerticalAlignment="Center" Command="{Binding NewEventCommand}" IsEnabled="{Binding CanAddEvent}" />
                <TextBlock Text="{Binding SelectedTitle}" Style="{StaticResource DisplayText}" FontSize="14" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </DockPanel>
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" />
            <TextBlock DockPanel.Dock="Top" Text="Nothing scheduled" Style="{StaticResource LabelText}" Margin="0,10,0,0"
                       Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVisibility}}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" />
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
