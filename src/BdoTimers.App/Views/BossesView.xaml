<UserControl x:Class="BdoTimers.App.Views.BossesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BdoTimers.App.Controls"
             xmlns:vm="clr-namespace:BdoTimers.App.ViewModels">
    <UserControl.Resources>
        <!-- A small gold pencil for bosses with their own alert times or sound, which don't follow the defaults -->
        <Style x:Key="OwnSettingsMark" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
            <Setter Property="Text" Value="&#xE70F;" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Own alert settings" />
            <Setter Property="Visibility" Value="{Binding OwnSettings, Converter={StaticResource BoolToVisibility}}" />
        </Style>
        <!-- Strip tile. The ContentControl's Tag "Next" makes it the large, gold-outlined tile. -->
        <DataTemplate x:Key="StripTile" DataType="{x:Type vm:StripTileViewModel}">
            <Border BorderThickness="1" Background="{DynamicResource BgBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}" Value="Next">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <!-- Text hugs the right edge, in the black the picture fades into; it may reach back only into the faded end -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition>
                            <ColumnDefinition.Style>
                                <Style TargetType="ColumnDefinition">
                                    <Setter Property="Width" Value="*" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMultipleBosses}" Value="True">
                                            <Setter Property="Width" Value="1.3*" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ColumnDefinition.Style>
                        </ColumnDefinition>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:ArtImage Sources="{Binding Images}">
                        <controls:ArtImage.Style>
                            <Style TargetType="controls:ArtImage">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMultipleBosses}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:ArtImage.Style>
                    </controls:ArtImage>
                    <!-- Each shared-spawn row owns its picture and name; timing belongs to the whole card. -->
                    <ItemsControl ItemsSource="{Binding Names}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasMultipleBosses}" Value="True" />
                                            <Condition Binding="{Binding HasSpawn}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="1" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BossLink}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:ArtImage Grid.ColumnSpan="2" Sources="{Binding Images}" />
                                    <Button Grid.Column="1" Margin="-16,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                            Style="{StaticResource NameButton}" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource DisplayText}" FontSize="14"
                                                   TextWrapping="Wrap" TextAlignment="Right" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" TextBlock.TextAlignment="Right"
                                Visibility="{Binding HasSpawn, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Margin" Value="-16,0,16,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMultipleBosses}" Value="True">
                                        <Setter Property="Margin" Value="8,0,16,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <!-- Label and clock shrink to fit a narrow tile rather than lose their ends -->
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Label}" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}" Value="Next">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        </Viewbox>
                        <ItemsControl ItemsSource="{Binding Names}" Margin="0,2,0,0">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMultipleBosses}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BossLink}">
                                    <Button Style="{StaticResource NameButton}" Command="{Binding OpenCommand}" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource DisplayText}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Right" Margin="0,2,0,0">
                        <TextBlock Text="{Binding Clock}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ClockText}">
                                    <Setter Property="FontSize" Value="17" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}" Value="Next">
                                            <Setter Property="FontSize" Value="30" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        </Viewbox>
                        <TextBlock Text="Skipped" Style="{StaticResource LabelText}"
                                   Visibility="{Binding Skipped, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- A boss name in the week grid, coloured by its state -->
        <Style x:Key="GridEntryButton" TargetType="Button" BasedOn="{StaticResource NameButton}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="ToolTip" Value="{Binding Tooltip}" />
            <Setter Property="ContextMenuService.IsEnabled" Value="{Binding CanSkip}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Past">
                    <Setter Property="Foreground" Value="{DynamicResource PastBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Unfollowed">
                    <Setter Property="Foreground" Value="{DynamicResource PastBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Skipped">
                    <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Next">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Boss tile under the table: the whole tile opens the boss panel; the corner gear says so -->
        <Style x:Key="BossTileButton" TargetType="Button" BasedOn="{StaticResource TileButton}">
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="ToolTip" Value="Alerts, sound and spawn times" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{DynamicResource BgBrush}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                ClipToBounds="True">
                            <Grid>
                                <ContentPresenter />
                                <TextBlock x:Name="Gear" Style="{StaticResource IconText}" Text="&#xE713;" FontSize="11" Opacity="0.55"
                                           Foreground="{DynamicResource SubtleBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,7,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Gear" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                <Setter TargetName="Gear" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type vm:BossTileViewModel}">
            <Button Style="{StaticResource BossTileButton}" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}">
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOff}" Value="True">
                                    <Setter Property="Opacity" Value="0.45" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <controls:ArtImage Sources="{Binding Images}" Width="96" HorizontalAlignment="Left" />
                    <!-- Right-aligned in the black; the left margin keeps long names off the picture -->
                    <StackPanel Margin="80,0,24,0" VerticalAlignment="Center" HorizontalAlignment="Right" TextBlock.TextAlignment="Right">
                        <DockPanel HorizontalAlignment="Right">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource OwnSettingsMark}" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding Name}" Style="{StaticResource DisplayText}" FontSize="13" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource LabelText}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="116">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.45*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentControl Content="{Binding Previous}" ContentTemplate="{StaticResource StripTile}" Opacity="0.6" Focusable="False" />
            <ContentControl Grid.Column="2" Tag="Next" Content="{Binding Next}" ContentTemplate="{StaticResource StripTile}" Focusable="False" />
            <ContentControl Grid.Column="4" Content="{Binding FollowedBy}" ContentTemplate="{StaticResource StripTile}" Focusable="False" />
        </Grid>

        <!-- The week table and the Bosses section scroll together under the pinned strip -->
        <ScrollViewer Margin="0,22,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <FrameworkElement Width="56" DockPanel.Dock="Left" />
                    <ItemsControl ItemsSource="{Binding Days}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DayHeaderViewModel}">
                                <Border Margin="6,0" BorderThickness="0,0,0,1" Padding="0,0,0,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DisplayText}">
                                                <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GridRowViewModel}">
                            <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0">
                                <DockPanel>
                                    <TextBlock Text="{Binding Time}" Width="56" DockPanel.Dock="Left" Style="{StaticResource ClockText}"
                                               FontWeight="Normal" FontSize="12" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" />
                                    <ItemsControl ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:GridCellViewModel}">
                                                <Border Margin="1,2" Padding="4,5" MinHeight="46" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="Transparent" />
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource AccentFillBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <ItemsControl ItemsSource="{Binding Entries}" VerticalAlignment="Center">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:GridEntryViewModel}">
                                                                <Button Style="{StaticResource GridEntryButton}" Command="{Binding OpenCommand}" HorizontalAlignment="Center">
                                                                    <Button.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="{Binding SkipLabel}" Command="{Binding ToggleSkipCommand}" />
                                                                        </ContextMenu>
                                                                    </Button.ContextMenu>
                                                                    <!-- A long name wraps within its day's column -->
                                                                    <DockPanel>
                                                                    <!-- Invisible twin of the pencil: the name alone is centred and the pencil hangs to its right -->
                                                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource OwnSettingsMark}" Margin="0,0,4,0" Opacity="0" IsHitTestVisible="False" />
                                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource OwnSettingsMark}" Margin="4,0,0,0" />
                                                                    <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding State}" Value="Skipped">
                                                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    </DockPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" />

                <!-- As many columns of 215 px or more as fit; the negative margin absorbs the last tile's gap -->
                <ItemsControl ItemsSource="{Binding Tiles}" Margin="0,22,-8,0" Focusable="False">
                    <ItemsControl.Resources>
                        <!-- The last tile adds a boss -->
                        <DataTemplate DataType="{x:Type vm:BossesViewModel}">
                            <Button Style="{StaticResource TileButton}" Height="52" Margin="0,0,8,8" BorderBrush="Transparent"
                                    Command="{Binding AddBossCommand}" AutomationProperties.Name="Add a boss">
                                <Grid>
                                    <Rectangle Stroke="{DynamicResource HairlineStrongBrush}" StrokeThickness="1" StrokeDashArray="4 3" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Add boss" Style="{StaticResource DisplayText}" FontSize="12" Foreground="{DynamicResource SubtleBrush}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.Resources>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource WidthToColumns}, ConverterParameter=215}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
