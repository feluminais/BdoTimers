<UserControl x:Class="BdoTimers.App.Views.Panels.LeadChips"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BdoTimers.App.Controls"
             xmlns:pvm="clr-namespace:BdoTimers.App.ViewModels.Panels">
    <WrapPanel>
        <ItemsControl ItemsSource="{Binding Chips}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type pvm:LeadChip}">
                    <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding IsOn}" ToolTip="{Binding Tip}"
                                  AutomationProperties.Name="{Binding Label}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Label}" />
                            <TextBlock Text="&#xE711;" Style="{StaticResource IconText}" FontSize="8" Margin="6,1,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </ToggleButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- Typing a number and pressing Enter adds it as a chip -->
        <Grid Width="52" Margin="0,0,0,5" VerticalAlignment="Top" ToolTip="Type minutes and press Enter">
            <TextBlock Text="+ add" Foreground="{StaticResource PastBrush}" FontSize="12" Margin="3,3,0,0" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NewValue}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBox Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" FontSize="12"
                     controls:Ui.HasError="{Binding NewValueInvalid}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </Grid>
    </WrapPanel>
</UserControl>
