<UserControl x:Class="BdoTimers.App.Views.Panels.UpdatePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BdoTimers.App.Controls"
             Width="460">
    <StackPanel Margin="22,16,22,20">
        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" ToolTip="Close"
                    Command="{Binding DataContext.ClosePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock Text="Update available" Style="{StaticResource DisplayText}" FontSize="18" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Text="{Binding Version}" FontSize="14" Margin="0,0,0,10" />
        <TextBlock Text="This will open the GitHub release page:" TextWrapping="Wrap" />
        <TextBlock Text="{Binding ReleasePage}" Style="{StaticResource LabelText}" TextWrapping="Wrap" Margin="0,6,0,10" />
        <TextBlock Text="Download the .exe to update." />
        <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0,8,0,0"
                   Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource GhostButton}" Content="Cancel" Margin="0,0,10,0"
                    Command="{Binding DataContext.ClosePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button controls:Ui.InitialFocus="True" Style="{StaticResource OutlineButton}" Content="Open GitHub" IsDefault="True" Command="{Binding OpenGitHubCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
