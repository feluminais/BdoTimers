<UserControl x:Class="BdoTimers.App.Views.Panels.SlotList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BdoTimers.App.Controls"
             xmlns:pvm="clr-namespace:BdoTimers.App.ViewModels.Panels"
             x:Name="Root">
    <StackPanel>
        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type pvm:SlotRowViewModel}">
                    <Border Style="{StaticResource Row}" MinHeight="34" Padding="0,4">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" ToolTip="Remove"
                                    Command="{Binding DataContext.RemoveCommand, ElementName=Root}" CommandParameter="{Binding}" />
                            <controls:CycleSelector ItemsSource="{Binding Days}" SelectedItem="{Binding Day}" ValueWidth="96" />
                            <TextBox Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}" Width="64" Margin="18,0,0,0"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" controls:Ui.HasError="{Binding Invalid}"
                                     ToolTip="24-hour time, e.g. 21:15" />
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Style="{StaticResource LinkButton}" Content="+ Add time" HorizontalAlignment="Left" Margin="0,4,0,0" Command="{Binding AddTimeCommand}" />
    </StackPanel>
</UserControl>
