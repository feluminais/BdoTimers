<UserControl x:Class="BdoTimers.App.Views.Panels.SlotList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BdoTimers.App.Controls"
             xmlns:pvm="clr-namespace:BdoTimers.App.ViewModels.Panels"
             x:Name="Root">
    <StackPanel>
        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type pvm:SlotRowViewModel}">
                    <Border Style="{StaticResource Row}" MinHeight="34" Padding="0,4">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" ToolTip="Remove"
                                    Command="{Binding DataContext.RemoveCommand, ElementName=Root}" CommandParameter="{Binding}" />
                            <controls:CycleSelector DockPanel.Dock="Left" ItemsSource="{Binding Days}" SelectedItem="{Binding Day}" ValueWidth="96" />
                            <TextBox Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}" Width="64" Margin="18,0,0,0"
                                     DockPanel.Dock="Left" VerticalAlignment="Center" controls:Ui.HasError="{Binding Invalid}" controls:Ui.TimeEntry="True"
                                     ToolTip="24-hour time, e.g. 21:15" />
                            <!-- Shown after the timer's name in alerts and lists: "War of the Roses · Battle" -->
                            <TextBox Text="{Binding LabelText, UpdateSourceTrigger=PropertyChanged, Delay=300}" Margin="14,0,10,0"
                                     VerticalAlignment="Center" ToolTip="Name of this time, such as Battle; optional"
                                     AutomationProperties.Name="Label"
                                     Visibility="{Binding DataContext.HasLabels, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <DockPanel Margin="0,4,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Reset to default"
                    Visibility="{Binding MayReset, Converter={StaticResource BoolToVisibility}}" Command="{Binding ResetCommand}" />
            <Button Style="{StaticResource LinkButton}" Content="+ Add time" HorizontalAlignment="Left"
                    Visibility="{Binding MayAddTime, Converter={StaticResource BoolToVisibility}}" Command="{Binding AddTimeCommand}" />
        </DockPanel>
    </StackPanel>
</UserControl>
