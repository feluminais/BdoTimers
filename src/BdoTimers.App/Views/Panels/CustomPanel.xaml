<UserControl x:Class="BdoTimers.App.Views.Panels.CustomPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BdoTimers.App.Controls"
             xmlns:panels="clr-namespace:BdoTimers.App.Views.Panels"
             MaxWidth="440" HorizontalAlignment="Stretch">
    <DockPanel>
        <DockPanel.Style>
            <Style TargetType="DockPanel">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Alerts.Generating}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                </Style.Triggers>
            </Style>
        </DockPanel.Style>
        <Grid DockPanel.Dock="Top" Height="88">
            <Button x:Name="PictureButton" Style="{StaticResource PictureButton}" Width="230" HorizontalAlignment="Left"
                    AutomationProperties.Name="Change picture" IsEnabled="{Binding CanChangePicture}" Click="PictureButton_Click">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Choose picture…" Command="{Binding ChoosePictureCommand}" />
                        <MenuItem Header="Remove picture" Command="{Binding RemovePictureCommand}" IsEnabled="{Binding HasPicture}" />
                    </ContextMenu>
                </Button.ContextMenu>
                <controls:ArtImage Sources="{Binding Images}" />
            </Button>
            <!-- Right-aligned in the black, clear of the close button; long names are trimmed before the picture -->
            <TextBlock Text="{Binding Name}" Style="{StaticResource DisplayText}" FontSize="20" TextTrimming="CharacterEllipsis"
                       Margin="186,0,44,0" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" IsHitTestVisible="False" />
            <Button Style="{StaticResource PanelCloseButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" />
        </Grid>

        <DockPanel DockPanel.Dock="Bottom" Margin="22,4,22,16">
            <Button Style="{StaticResource PanelDoneButton}" Content="Save" IsDefault="True" IsEnabled="{Binding CanFinish}" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}">
                <Button Style="{StaticResource DangerLinkButton}" Content="Delete" Command="{Binding Delete.AskCommand}"
                        Visibility="{Binding Delete.IsAsking, Converter={StaticResource InverseBoolToVisibility}}" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding Delete.IsAsking, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Delete?" Foreground="{DynamicResource SubtleBrush}" FontSize="12" VerticalAlignment="Center" />
                    <Button Style="{StaticResource DangerLinkButton}" Content="Yes" Margin="10,0,0,0" Command="{Binding Delete.ConfirmCommand}" />
                    <TextBlock Text="·" Foreground="{DynamicResource PastBrush}" Margin="8,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource LinkButton}" Content="No" Command="{Binding Delete.CancelCommand}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="22,2,22,8">
                <TextBlock Text="{Binding PictureError}" Style="{StaticResource ErrorText}" Margin="0,0,0,6"
                           Visibility="{Binding PictureError, Converter={StaticResource NullToCollapsed}}" />
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <TextBlock Text="Name" Style="{StaticResource RowLabel}" Width="120" />
                        <TextBox controls:Ui.InitialFocus="True" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Delay=300}" VerticalAlignment="Center"
                                 controls:Ui.HasError="{Binding NameInvalid}" />
                    </DockPanel>
                </Border>

                <StackPanel Visibility="{Binding IsFarm, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Crop growth" Style="{StaticResource SectionText}"
                               ToolTip="Online growth estimate. Pause while offline; crop care can delay harvest." />
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <TextBlock Text="Temperature" Style="{StaticResource RowLabel}" Width="110" />
                            <ComboBox ItemsSource="{Binding FarmGrowthOptions}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding FarmGrowth}" VerticalAlignment="Center"
                                      AutomationProperties.Name="Crop temperature and growth time" />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Duration"
                                        Visibility="{Binding IsCountdown, Converter={StaticResource BoolToVisibility}}">
                    <TextBox x:Name="DurationBox" Width="80" TextAlignment="Right" VerticalAlignment="Center"
                             Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                             PreviewKeyDown="DurationBox_PreviewKeyDown" LostKeyboardFocus="DurationBox_LostKeyboardFocus"
                             controls:Ui.HasError="{Binding DurationInvalid}" ToolTip="Hours:minutes, e.g. 1:30, or just minutes" />
                </HeaderedContentControl>

                <Border Style="{StaticResource Row}" Visibility="{Binding IsHorseTemplate, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <controls:HotkeyBox DockPanel.Dock="Right" Combo="{Binding HorseHotkey}" Taken="{Binding OtherHotkeys}" Hotkeys="{Binding Hotkeys}" Target="{Binding HotkeyTarget}" AutomationProperties.Name="Start horse registration hotkey" />
                        <TextBlock Text="Start hotkey" Style="{StaticResource RowLabel}" />
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Row}" Visibility="{Binding IsCustomCountdown, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <controls:HotkeyBox DockPanel.Dock="Right" Combo="{Binding ControlHotkey}" Taken="{Binding OtherHotkeys}" Hotkeys="{Binding Hotkeys}" Target="{Binding HotkeyTarget}"
                                            AutomationProperties.Name="Countdown hotkey" />
                        <TextBlock Text="Hotkey" Style="{StaticResource RowLabel}" ToolTip="Start, pause or resume" />
                    </DockPanel>
                </Border>

                <StackPanel Visibility="{Binding IsWeekly, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding WeeklyHeading}" Style="{StaticResource SectionText}" />
                    <panels:SlotList DataContext="{Binding Slots}" />
                    <Border Style="{StaticResource Row}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Repeat every" Style="{StaticResource RowLabel}" Width="120" />
                            <TextBox Width="48" TextAlignment="Right" VerticalAlignment="Center"
                                     Text="{Binding EveryWeeksText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                     controls:Ui.HasError="{Binding EveryWeeksInvalid}" ToolTip="1–52" AutomationProperties.Name="Repeat every weeks" />
                            <TextBlock Text="weeks" Style="{StaticResource RowLabel}" Margin="10,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Row}" Visibility="{Binding HasWeekAnchor, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <TextBlock Text="From week of" Style="{StaticResource RowLabel}" Width="120" />
                            <controls:DateInput Text="{Binding WeekAnchorText, UpdateSourceTrigger=PropertyChanged}" TodayProvider="{Binding TodayProvider}"
                                                HasError="{Binding WeekAnchorInvalid}" ToolTip="A date in a running week; weeks start Monday"
                                                AutomationProperties.Name="From week of" />
                        </DockPanel>
                    </Border>
                    <StackPanel Margin="0,6,0,4" Visibility="{Binding IsWarOfTheRoses, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource LinkButton}" Content="{Binding ResetTimesLabel}" HorizontalAlignment="Left"
                                Command="{Binding ResetTimes.AskCommand}"
                                Visibility="{Binding ResetTimes.IsAsking, Converter={StaticResource InverseBoolToVisibility}}" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding ResetTimes.IsAsking, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Reset times?" Style="{StaticResource LabelText}" FontSize="12" VerticalAlignment="Center" />
                            <Button Style="{StaticResource DangerLinkButton}" Content="Yes" Margin="10,0,0,0" Command="{Binding ResetTimes.ConfirmCommand}" />
                            <TextBlock Text="·" Foreground="{DynamicResource PastBrush}" Margin="8,0" VerticalAlignment="Center" />
                            <Button Style="{StaticResource LinkButton}" Content="No" Command="{Binding ResetTimes.CancelCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource Row}" Visibility="{Binding HasWeeklyDateRange, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <TextBlock Text="Start date" Style="{StaticResource RowLabel}" Width="120" />
                            <controls:DateInput Text="{Binding StartDateText, UpdateSourceTrigger=PropertyChanged}" TodayProvider="{Binding TodayProvider}"
                                                HasError="{Binding StartDateInvalid}" ToolTip="YYYY-MM-DD; blank for no limit" AutomationProperties.Name="Start date" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}" Visibility="{Binding HasWeeklyDateRange, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <TextBlock Text="End date" Style="{StaticResource RowLabel}" Width="120" />
                            <controls:DateInput Text="{Binding EndDateText, UpdateSourceTrigger=PropertyChanged}" TodayProvider="{Binding TodayProvider}"
                                                HasError="{Binding EndDateInvalid}" ToolTip="YYYY-MM-DD, inclusive; blank for no limit" AutomationProperties.Name="End date" />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <StackPanel Visibility="{Binding IsOneTime, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="One-time event" Style="{StaticResource SectionText}" />
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <TextBlock Text="Date" Style="{StaticResource RowLabel}" Width="120" />
                            <controls:DateInput Text="{Binding EventDateText, UpdateSourceTrigger=PropertyChanged}" TodayProvider="{Binding TodayProvider}"
                                                HasError="{Binding EventDateInvalid}" ToolTip="YYYY-MM-DD" AutomationProperties.Name="Event date" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <TextBlock Text="Time" Style="{StaticResource RowLabel}" Width="120" />
                            <TextBox Text="{Binding EventTimeText, UpdateSourceTrigger=PropertyChanged, Delay=300}" VerticalAlignment="Center"
                                     controls:Ui.HasError="{Binding EventTimeInvalid}" controls:Ui.TimeEntry="True" ToolTip="HH:mm" AutomationProperties.Name="Event time" />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <StackPanel Visibility="{Binding HasTimeZone, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource Row}" Margin="0,6,0,0">
                        <DockPanel>
                            <TextBlock Text="Time zone" Style="{StaticResource RowLabel}" Width="120" />
                            <ComboBox controls:Ui.TypeToSearch="True" ItemsSource="{Binding TimeZones}" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                      SelectedValue="{Binding TimeZoneId}" MaxDropDownHeight="260" VerticalAlignment="Center"
                                      AutomationProperties.Name="Event time zone" />
                        </DockPanel>
                    </Border>
                    <TextBlock Text="{Binding ScheduleError}" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,4,0,6"
                               Visibility="{Binding ScheduleValid, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>

                <StackPanel Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVisibility}}">
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Alerts">
                        <ToggleButton Style="{StaticResource OnOffSwitch}" IsChecked="{Binding AlertsOn}" Width="110"
                                                AutomationProperties.Name="Alerts" />
                    </HeaderedContentControl>
                    <panels:AlertRows DataContext="{Binding Alerts}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
