<UserControl x:Class="BdoTimers.App.Views.Panels.CustomPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BdoTimers.App.Controls"
             xmlns:panels="clr-namespace:BdoTimers.App.Views.Panels"
             Width="440">
    <UserControl.Resources>
        <!-- The header picture: the whole area is clickable, and a labelled badge in its corner says so -->
        <Style x:Key="PictureButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter />
                            <Border x:Name="Badge" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,10" Padding="6,4"
                                    Background="#D90B0B0C" BorderBrush="{StaticResource HairlineStrongBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Icon" Style="{StaticResource IconText}" Text="&#xEB9F;" FontSize="12"
                                               Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="Label" Text="Change picture" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource SubtleBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Badge" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Badge" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="88">
            <!-- Clicking the picture offers to change or remove it -->
            <Button x:Name="PictureButton" Style="{StaticResource PictureButton}" Width="230" HorizontalAlignment="Left"
                    AutomationProperties.Name="Change picture" Click="PictureButton_Click">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Choose picture…" Command="{Binding ChoosePictureCommand}" />
                        <MenuItem Header="Remove picture" Command="{Binding RemovePictureCommand}" IsEnabled="{Binding HasPicture}" />
                    </ContextMenu>
                </Button.ContextMenu>
                <controls:ArtImage Sources="{Binding Images}" />
            </Button>
            <!-- Right-aligned in the black, clear of the close button; long names are trimmed before the picture -->
            <StackPanel Margin="186,0,44,0" VerticalAlignment="Center" HorizontalAlignment="Right" TextBlock.TextAlignment="Right"
                        IsHitTestVisible="False">
                <TextBlock Text="{Binding Name}" Style="{StaticResource DisplayText}" FontSize="20" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding KindText}" Style="{StaticResource LabelText}" />
            </StackPanel>
            <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" ToolTip="Close"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                    Command="{Binding DataContext.ClosePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Grid>

        <DockPanel DockPanel.Dock="Bottom" Margin="22,4,22,16">
            <Button Style="{StaticResource OutlineButton}" Content="Done" DockPanel.Dock="Right" IsDefault="True"
                    Command="{Binding DataContext.ClosePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource DangerLinkButton}" Content="Delete" Command="{Binding AskDeleteCommand}"
                        Visibility="{Binding ConfirmingDelete, Converter={StaticResource InverseBoolToVisibility}}" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding ConfirmingDelete, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Delete?" Foreground="{StaticResource SubtleBrush}" FontSize="12" VerticalAlignment="Center" />
                    <Button Style="{StaticResource DangerLinkButton}" Content="Yes" Margin="10,0,0,0" Command="{Binding ConfirmDeleteCommand}" />
                    <TextBlock Text="·" Foreground="{StaticResource PastBrush}" Margin="8,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource LinkButton}" Content="No" Command="{Binding CancelDeleteCommand}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="22,2,22,8">
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <TextBlock Text="Name" Style="{StaticResource RowLabel}" Width="120" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Delay=300}" VerticalAlignment="Center"
                                 controls:Ui.HasError="{Binding NameInvalid}" />
                    </DockPanel>
                </Border>

                <StackPanel Visibility="{Binding IsCountdown, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <TextBox DockPanel.Dock="Right" Width="80" TextAlignment="Right" VerticalAlignment="Center"
                                     Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                     controls:Ui.HasError="{Binding DurationInvalid}" ToolTip="Hours:minutes, e.g. 1:30, or just minutes" />
                            <TextBlock Text="Duration" Style="{StaticResource RowLabel}" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <controls:CycleSelector DockPanel.Dock="Right" ItemsSource="{Binding OnOff}" SelectedItem="{Binding Repeat}" ValueWidth="110" />
                            <TextBlock Text="Restart when it ends" Style="{StaticResource RowLabel}" />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <StackPanel Visibility="{Binding IsWeekly, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Weekly times" Style="{StaticResource SectionText}" />
                    <panels:SlotList DataContext="{Binding Slots}" />
                    <Border Style="{StaticResource Row}" Margin="0,6,0,0">
                        <DockPanel>
                            <TextBlock Text="Time zone" Style="{StaticResource RowLabel}" Width="120" />
                            <ComboBox ItemsSource="{Binding TimeZones}" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                                      SelectedValue="{Binding TimeZoneId}" MaxDropDownHeight="260" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <controls:CycleSelector DockPanel.Dock="Right" ItemsSource="{Binding OnOff}" SelectedItem="{Binding Active}" ValueWidth="110" />
                        <TextBlock Text="Active" Style="{StaticResource RowLabel}" />
                    </DockPanel>
                </Border>
                <panels:AlertRows DataContext="{Binding Alerts}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
