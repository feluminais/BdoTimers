<UserControl x:Class="BdoTimers.App.Views.Panels.BossPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BdoTimers.App.Controls"
             xmlns:panels="clr-namespace:BdoTimers.App.Views.Panels"
             Width="440">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="88">
            <controls:ArtImage Sources="{Binding Images}" Width="200" HorizontalAlignment="Left" />
            <StackPanel Margin="186,0,40,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" Style="{StaticResource DisplayText}" FontSize="20" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding NextText}" Style="{StaticResource LabelText}" />
                <TextBlock Text="{Binding AppliesText}" Style="{StaticResource LabelText}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" ToolTip="Close"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                    Command="{Binding DataContext.ClosePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Grid>

        <DockPanel DockPanel.Dock="Bottom" Margin="22,4,22,16">
            <Button Style="{StaticResource OutlineButton}" Content="Done" DockPanel.Dock="Right" IsDefault="True"
                    Command="{Binding DataContext.ClosePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Button Style="{StaticResource LinkButton}" Content="Edit spawn times" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Command="{Binding ToggleTimesCommand}" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="22,2,22,8">
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <controls:CycleSelector DockPanel.Dock="Right" ItemsSource="{Binding OnOff}" SelectedItem="{Binding AlertsOn}" ValueWidth="110"
                                                AutomationProperties.Name="Alerts" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Alerts" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="Off: no alerts, hidden from the strip" Style="{StaticResource LabelText}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <panels:AlertRows DataContext="{Binding Alerts}" />
                <StackPanel Visibility="{Binding ShowTimes, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Spawn times" Style="{StaticResource SectionText}" />
                    <TextBlock Text="{Binding TimeZoneNote}" Style="{StaticResource LabelText}" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <panels:SlotList DataContext="{Binding Slots}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
