<UserControl x:Class="BdoTimers.App.Views.Panels.OverlayPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BdoTimers.App.Controls"
             xmlns:pvm="clr-namespace:BdoTimers.App.ViewModels.Panels"
             Width="460">
    <UserControl.Resources>
        <!-- A colour square; the chosen one gets a gold ring -->
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring" BorderThickness="1" BorderBrush="{StaticResource HairlineStrongBrush}" Padding="2">
                            <Border Background="{TemplateBinding Background}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Ring" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="22,16,12,4">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" ToolTip="Close"
                    Command="{Binding DataContext.ClosePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock Text="Overlay" Style="{StaticResource DisplayText}" FontSize="18" VerticalAlignment="Center" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="22,8,22,16" LastChildFill="False">
            <Button Style="{StaticResource OutlineButton}" Content="Done" DockPanel.Dock="Right" IsDefault="True"
                    Command="{Binding DataContext.ClosePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="22,0,22,4">
                <TextBlock Text="Show" Style="{StaticResource SectionText}" Margin="0,4,0,4" />
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <controls:CycleSelector DockPanel.Dock="Right" ItemsSource="{Binding OnOff}" SelectedItem="{Binding Enabled}" ValueWidth="60"
                                                AutomationProperties.Name="Overlay" />
                        <TextBlock Text="Overlay" Style="{StaticResource RowLabel}" />
                    </DockPanel>
                </Border>

                <StackPanel Visibility="{Binding Enabled.IsOn, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <controls:CycleSelector DockPanel.Dock="Right" ItemsSource="{Binding OnOff}" SelectedItem="{Binding AlwaysShow}"
                                                    ValueWidth="60" VerticalAlignment="Top" AutomationProperties.Name="Always show" />
                            <controls:HotkeyBox DockPanel.Dock="Right" Margin="0,0,14,0" Combo="{Binding AlwaysShowHotkey}" Other="{Binding ShowHotkey}" Other2="{Binding HorseHotkey}"
                                                IsRefused="{Binding AlwaysShowRefused}" IsListening="{Binding ListeningAlwaysShow}"
                                                AutomationProperties.Name="Always show hotkey" />
                            <TextBlock Text="Always show" Style="{StaticResource RowLabel}" VerticalAlignment="Top" Margin="0,3,0,0" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <controls:CycleSelector DockPanel.Dock="Right" ItemsSource="{Binding OnOff}" SelectedItem="{Binding ShowOnHotkey}"
                                                    ValueWidth="60" VerticalAlignment="Top" AutomationProperties.Name="Show on hotkey" />
                            <controls:HotkeyBox DockPanel.Dock="Right" Margin="0,0,14,0" Combo="{Binding ShowHotkey}" Other="{Binding AlwaysShowHotkey}" Other2="{Binding HorseHotkey}"
                                                IsRefused="{Binding ShowRefused}" IsListening="{Binding ListeningShow}"
                                                AutomationProperties.Name="Show hotkey" />
                            <TextBlock Text="Show on hotkey" Style="{StaticResource RowLabel}" VerticalAlignment="Top" Margin="0,3,0,0" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}" Visibility="{Binding ShowOnHotkey.IsOn, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <controls:CycleSelector DockPanel.Dock="Right" ItemsSource="{Binding SecondsChoices}" SelectedItem="{Binding ShowSeconds}"
                                                    ValueWidth="60" AutomationProperties.Name="Show for" />
                            <TextBlock Text="For" Style="{StaticResource RowLabel}" Margin="14,0,0,0" />
                        </DockPanel>
                    </Border>

                    <TextBlock Text="Look" Style="{StaticResource SectionText}" />
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <controls:CycleSelector DockPanel.Dock="Right" ItemsSource="{Binding Layouts}" SelectedItem="{Binding Layout}" ValueWidth="60"
                                                    AutomationProperties.Name="Layout" />
                            <TextBlock Text="Layout" Style="{StaticResource RowLabel}" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <Slider DockPanel.Dock="Right" Width="170" Minimum="0.6" Maximum="2" VerticalAlignment="Center"
                                    Value="{Binding Scale, Delay=100}" AutomationProperties.Name="Size" />
                            <TextBlock Text="Size" Style="{StaticResource RowLabel}" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <StackPanel>
                            <TextBlock Text="Sections" Style="{StaticResource RowLabel}" Margin="0,0,0,6" />
                            <WrapPanel>
                                <ToggleButton Style="{StaticResource Chip}" Content="Clock" IsChecked="{Binding ShowClock}" />
                                <ToggleButton Style="{StaticResource Chip}" Content="Previous boss" IsChecked="{Binding ShowPrevious}" />
                                <ToggleButton Style="{StaticResource Chip}" Content="Next boss" IsChecked="{Binding ShowNext}" />
                                <ToggleButton Style="{StaticResource Chip}" Content="Farm" IsChecked="{Binding ShowFarm}" />
                                <ToggleButton Style="{StaticResource Chip}" Content="Fishing" IsChecked="{Binding ShowFishing}" />
                                <ToggleButton Style="{StaticResource Chip}" Content="Horse registrations" IsChecked="{Binding ShowHorseRegistrations}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Background" Style="{StaticResource SectionText}" />
                    <Border Style="{StaticResource Row}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ItemsControl ItemsSource="{Binding Swatches}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type pvm:Swatch}">
                                            <Button Style="{StaticResource SwatchButton}" Background="{Binding Brush}" Command="{Binding PickCommand}"
                                                    ToolTip="{Binding Hex}" AutomationProperties.Name="{Binding Hex}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border BorderThickness="1" Padding="6,2" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCustomColor}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Button Style="{StaticResource LinkButton}" Content="Custom…" Command="{Binding OpenCustomColorCommand}" />
                                </Border>
                            </StackPanel>
                            <controls:ColorPicker Color="{Binding CustomColor}" Margin="0,10,0,2" HorizontalAlignment="Left"
                                                  Visibility="{Binding PickerOpen, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        Visibility="{Binding HasPicture, Converter={StaticResource BoolToVisibility}}">
                                <Border Width="48" Height="28" ClipToBounds="True" Margin="0,0,10,0">
                                    <Image Source="{Binding Picture}" Stretch="UniformToFill" />
                                </Border>
                                <Button Style="{StaticResource LinkButton}" Content="Remove picture" VerticalAlignment="Center"
                                        Command="{Binding RemovePictureCommand}" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Choose picture…" VerticalAlignment="Center"
                                    Command="{Binding ChoosePictureCommand}"
                                    Visibility="{Binding HasPicture, Converter={StaticResource InverseBoolToVisibility}}" />
                            <TextBlock Text="Picture" Style="{StaticResource RowLabel}" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <Slider DockPanel.Dock="Right" Width="170" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                    Value="{Binding BackgroundOpacity, Delay=100}" AutomationProperties.Name="Background opacity" />
                            <TextBlock Text="Background opacity" Style="{StaticResource RowLabel}" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <Slider DockPanel.Dock="Right" Width="170" Minimum="0.2" Maximum="1" VerticalAlignment="Center"
                                    Value="{Binding TextOpacity, Delay=100}" AutomationProperties.Name="Text opacity" />
                            <TextBlock Text="Text opacity" Style="{StaticResource RowLabel}" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
