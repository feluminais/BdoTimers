<UserControl x:Class="BdoTimers.App.Views.Panels.OverlayPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BdoTimers.App.Controls"
             xmlns:pvm="clr-namespace:BdoTimers.App.ViewModels.Panels"
             Width="460">
    <UserControl.Resources>
        <!-- A colour square; the chosen one gets a gold ring -->
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring" BorderThickness="1" BorderBrush="{DynamicResource HairlineStrongBrush}" Padding="2">
                            <Border Background="{TemplateBinding Background}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Ring" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="22,16,12,4">
            <Button DockPanel.Dock="Right" Style="{StaticResource PanelCloseButton}" />
            <TextBlock Text="Overlay" Style="{StaticResource DisplayText}" FontSize="18" VerticalAlignment="Center" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="22,8,22,16" LastChildFill="False">
            <Button Style="{StaticResource PanelDoneButton}" IsDefault="True" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="22,0,22,4">
                <TextBlock Text="Show" Style="{StaticResource SectionText}" Margin="0,4,0,4" />
                <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Overlay">
                    <ToggleButton controls:Ui.InitialFocus="True" Style="{StaticResource OnOffSwitch}" IsChecked="{Binding Enabled}" Width="60"
                                            AutomationProperties.Name="Overlay" />
                </HeaderedContentControl>

                <StackPanel Visibility="{Binding Enabled, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <ToggleButton Style="{StaticResource OnOffSwitch}" DockPanel.Dock="Right" IsChecked="{Binding AlwaysShow}"
                                                    Width="60" VerticalAlignment="Top" AutomationProperties.Name="Always show" />
                            <controls:HotkeyBox DockPanel.Dock="Right" Margin="0,0,14,0" Combo="{Binding AlwaysShowHotkey}" Taken="{Binding TakenForAlwaysShow}" Hotkeys="{Binding Hotkeys}" Target="{Binding AlwaysShowTarget}"
                                                AutomationProperties.Name="Always show hotkey" />
                            <TextBlock Text="Always show" Style="{StaticResource RowLabel}" VerticalAlignment="Top" Margin="0,3,0,0" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <ToggleButton Style="{StaticResource OnOffSwitch}" DockPanel.Dock="Right" IsChecked="{Binding ShowOnHotkey}"
                                                    Width="60" VerticalAlignment="Top" AutomationProperties.Name="Show on hotkey" />
                            <controls:HotkeyBox DockPanel.Dock="Right" Margin="0,0,14,0" Combo="{Binding ShowHotkey}" Taken="{Binding TakenForShow}" Hotkeys="{Binding Hotkeys}" Target="{Binding ShowTarget}"
                                                AutomationProperties.Name="Show hotkey" />
                            <TextBlock Text="Show on hotkey" Style="{StaticResource RowLabel}" VerticalAlignment="Top" Margin="0,3,0,0" />
                        </DockPanel>
                    </Border>
                    <!-- Stays visible while Show on hotkey is off, so the timed show reads apart from Always show -->
                    <Border BorderThickness="0" IsEnabled="{Binding ShowOnHotkey}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Row}">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <controls:CycleSelector DockPanel.Dock="Right" ItemsSource="{Binding SecondsChoices}" SelectedItem="{Binding ShowSeconds}"
                                                    ValueWidth="60" AutomationProperties.Name="Show for" />
                            <TextBlock Text="For" Style="{StaticResource RowLabel}" Margin="14,0,0,0" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <controls:CycleSelector DockPanel.Dock="Right" ItemsSource="{Binding GuildBossChoices}" SelectedItem="{Binding GuildBosses}"
                                                    ValueWidth="110" AutomationProperties.Name="Guild bosses" />
                            <TextBlock Text="Guild bosses" Style="{StaticResource RowLabel}" />
                        </DockPanel>
                    </Border>

                    <TextBlock Text="Look" Style="{StaticResource SectionText}" />
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Layout">
                        <controls:CycleSelector ItemsSource="{Binding Layouts}" SelectedItem="{Binding Layout}" ValueWidth="60"
                                                AutomationProperties.Name="Layout" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Size">
                        <Slider Width="170" Minimum="0.6" Maximum="2" VerticalAlignment="Center"
                                Value="{Binding Scale, Delay=100}" AutomationProperties.Name="Size" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Outline">
                        <ToggleButton Style="{StaticResource OnOffSwitch}" IsChecked="{Binding Outline}" Width="60"
                                                AutomationProperties.Name="Outline" />
                    </HeaderedContentControl>
                    <Border Style="{StaticResource Row}">
                        <StackPanel>
                            <TextBlock Text="Sections" Style="{StaticResource RowLabel}" Margin="0,0,0,6" />
                            <WrapPanel>
                                <ToggleButton Style="{StaticResource Chip}" Content="Local time" IsChecked="{Binding ShowClock}" />
                                <ToggleButton Style="{StaticResource Chip}" Content="Server time" IsChecked="{Binding ShowServerTime}" />
                                <ToggleButton Style="{StaticResource Chip}" Content="In-game time" IsChecked="{Binding ShowGameTime}" />
                                <ToggleButton Style="{StaticResource Chip}" Content="Previous boss" IsChecked="{Binding ShowPrevious}" />
                                <ToggleButton Style="{StaticResource Chip}" Content="Next boss" IsChecked="{Binding ShowNext}" />
                                <ToggleButton Style="{StaticResource Chip}" Content="Farm" IsChecked="{Binding ShowFarm}" />
                                <ToggleButton Style="{StaticResource Chip}" Content="Fishing" IsChecked="{Binding ShowFishing}" />
                                <ToggleButton Style="{StaticResource Chip}" Content="Horse registrations" IsChecked="{Binding ShowHorseRegistrations}" />
                                <ToggleButton Style="{StaticResource Chip}" Content="Custom timers" IsChecked="{Binding ShowCustomTimers}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Row}" Visibility="{Binding ShowServerTime, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{Binding ServerRegion}" VerticalAlignment="Center"
                                    Command="{Binding OpenRegionSettingsCommand}" ToolTip="Change region in Settings"
                                    AutomationProperties.Name="Server time region" />
                            <TextBlock Text="Server time" Style="{StaticResource RowLabel}" />
                        </DockPanel>
                    </Border>

                    <TextBlock Text="Background" Style="{StaticResource SectionText}" />
                    <Border Style="{StaticResource Row}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ItemsControl ItemsSource="{Binding Swatches}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type pvm:Swatch}">
                                            <Button Style="{StaticResource SwatchButton}" Background="{Binding Brush}" Command="{Binding PickCommand}"
                                                    ToolTip="{Binding Hex}" AutomationProperties.Name="{Binding Hex}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border BorderThickness="1" Padding="6,2" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCustomColor}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Button Style="{StaticResource LinkButton}" Content="Custom…" Command="{Binding OpenCustomColorCommand}" />
                                </Border>
                            </StackPanel>
                            <controls:ColorPicker Color="{Binding CustomColor}" Margin="0,10,0,2" HorizontalAlignment="Left"
                                                  Visibility="{Binding PickerOpen, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            Visibility="{Binding HasPicture, Converter={StaticResource BoolToVisibility}}">
                                    <Border Width="48" Height="28" ClipToBounds="True" Margin="0,0,10,0">
                                        <Image Source="{Binding Picture}" Stretch="UniformToFill" />
                                    </Border>
                                    <Button Style="{StaticResource LinkButton}" Content="Remove picture" VerticalAlignment="Center"
                                            Command="{Binding RemovePictureCommand}" />
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Choose picture…" VerticalAlignment="Center"
                                        Command="{Binding ChoosePictureCommand}"
                                        Visibility="{Binding HasPicture, Converter={StaticResource InverseBoolToVisibility}}" />
                                <TextBlock Text="Picture" Style="{StaticResource RowLabel}" />
                            </DockPanel>
                            <TextBlock Text="{Binding PictureError}" Style="{StaticResource ErrorText}"
                                       Visibility="{Binding PictureError, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                    </Border>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Background opacity">
                        <Slider Width="170" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                Value="{Binding BackgroundOpacity, Delay=100}" AutomationProperties.Name="Background opacity" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Text opacity">
                        <Slider Width="170" Minimum="0.2" Maximum="1" VerticalAlignment="Center"
                                Value="{Binding TextOpacity, Delay=100}" AutomationProperties.Name="Text opacity" />
                    </HeaderedContentControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
