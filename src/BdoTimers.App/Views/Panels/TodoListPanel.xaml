<UserControl x:Class="BdoTimers.App.Views.Panels.TodoListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BdoTimers.App.Controls"
             xmlns:pvm="clr-namespace:BdoTimers.App.ViewModels.Panels"
             Width="600">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type pvm:TodoEditRowViewModel}">
            <StackPanel Margin="{Binding Indent}">
                <Grid x:Name="RowGrid" MinHeight="32" Tag="{Binding Id}" Background="Transparent"
                      PreviewMouseLeftButtonDown="Row_PreviewMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="14" Height="28" Background="Transparent" Cursor="SizeAll" ToolTip="Drag to move">
                        <Ellipse Width="4" Height="4" Fill="{StaticResource AccentBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.RenderTransform><TranslateTransform Y="-4" /></Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <TextBox x:Name="RowText" Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             BorderBrush="Transparent" PreviewKeyDown="RowText_PreviewKeyDown" Tag="{Binding Id}"
                             AutomationProperties.Name="To-do row" />
                    <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" Visibility="Hidden"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Width="25" Height="28"
                                ToolTip="Add child" Command="{Binding AddChildCommand}"
                                Visibility="{Binding CanAddChild, Converter={StaticResource BoolToVisibility}}">
                            <Path Data="M 1,9 L 17,9 M 9,1 L 9,17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" Width="18" Height="18" Stretch="None" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Width="25" Height="28"
                                ToolTip="Remove" Command="{Binding RemoveCommand}" />
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="14,2,0,4"
                            Visibility="{Binding ConfirmingRemove, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ChildCount, StringFormat='Remove with {0} rows?'}" Style="{StaticResource LabelText}"
                               VerticalAlignment="Center" />
                    <Button Style="{StaticResource DangerLinkButton}" Content="Yes" Command="{Binding ConfirmRemoveCommand}"
                            Margin="8,0,0,0" />
                    <Button Style="{StaticResource LinkButton}" Content="No" Command="{Binding CancelRemoveCommand}"
                            Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <Trigger SourceName="RowGrid" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                    <Setter TargetName="RowText" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger SourceName="RowGrid" Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="22,16,12,4">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" ToolTip="Close"
                    Command="{Binding DataContext.ClosePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource DisplayFont}"
                     FontSize="18" controls:Ui.HasError="{Binding InvalidName}" AutomationProperties.Name="List name">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource HairlineStrongBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="22,8,22,16">
            <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="Done"
                    Command="{Binding DataContext.ClosePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource DangerLinkButton}" Content="Delete list" Command="{Binding AskDeleteCommand}"
                        Visibility="{Binding ConfirmingDelete, Converter={StaticResource InverseBoolToVisibility}}" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding ConfirmingDelete, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Delete?" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource DangerLinkButton}" Content="Yes" Command="{Binding ConfirmDeleteCommand}" Margin="8,0,0,0" />
                    <Button Style="{StaticResource LinkButton}" Content="No" Command="{Binding CancelDeleteCommand}" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
        <ScrollViewer x:Name="RowsScrollViewer" MaxHeight="475" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="22,0,22,4">
                <Border Style="{StaticResource Row}" Margin="0,0,0,10">
                    <DockPanel>
                        <controls:CycleSelector DockPanel.Dock="Right" ItemsSource="{Binding OnOff}" SelectedItem="{Binding Enabled}"
                                                ValueWidth="90" AutomationProperties.Name="Active" />
                        <TextBlock Text="Active" Style="{StaticResource RowLabel}" />
                    </DockPanel>
                </Border>
                <ItemsControl x:Name="RowsControl" ItemsSource="{Binding Rows}" />
                <Button Style="{StaticResource LinkButton}" Content="+ Add item" Command="{Binding AddRowCommand}"
                        HorizontalAlignment="Left" Margin="14,10,0,6" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
