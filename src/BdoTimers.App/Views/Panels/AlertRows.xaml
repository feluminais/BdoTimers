<UserControl x:Class="BdoTimers.App.Views.Panels.AlertRows"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BdoTimers.App.Controls"
             xmlns:panels="clr-namespace:BdoTimers.App.Views.Panels">
    <StackPanel>
        <Border Style="{StaticResource Row}">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Use default" VerticalAlignment="Center"
                            Command="{Binding UseDefaultLeadsCommand}"
                            Visibility="{Binding LeadsFollowDefault, Converter={StaticResource InverseBoolToVisibility}}" />
                    <TextBlock DockPanel.Dock="Right" Text="Default" Style="{StaticResource LabelText}" VerticalAlignment="Center"
                               Visibility="{Binding LeadsFollowDefault, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="Alert times (minutes before)" Style="{StaticResource RowLabel}" />
                </DockPanel>
                <panels:LeadChips DataContext="{Binding Leads}" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Row}">
            <StackPanel DataContext="{Binding Sound}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE768;" Foreground="{DynamicResource AccentBrush}"
                            ToolTip="Play" Command="{Binding TestCommand}" />
                    <ComboBox DockPanel.Dock="Right" DisplayMemberPath="Label" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" Width="150"
                                            AutomationProperties.Name="Sound" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="0,0,4,0"
                            ToolTip="Add your own sound (WAV or MP3)" Command="{Binding AddCommand}">
                        <controls:PlusIcon Size="11" />
                    </Button>
                    <!-- Left of the others, so showing it moves nothing -->
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="9"
                            ToolTip="Remove this sound" Command="{Binding RemoveCommand}"
                            Visibility="{Binding IsUserSound, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="Sound" Style="{StaticResource RowLabel}" />
                </DockPanel>
                <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}"
                           Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
        </Border>
        <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Windows notification">
            <ToggleButton Style="{StaticResource OnOffSwitch}" IsChecked="{Binding Toast}" Width="110"
                                    AutomationProperties.Name="Windows notification" />
        </HeaderedContentControl>
        <Border Style="{StaticResource Row}">
            <StackPanel>
                <DockPanel>
                    <ToggleButton Style="{StaticResource OnOffSwitch}" DockPanel.Dock="Right" IsChecked="{Binding Voice}" Width="110"
                                            AutomationProperties.Name="Voice" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Voice" Style="{StaticResource RowLabel}" />
                        <TextBlock Text="{Binding VoiceSample}" Style="{StaticResource LabelText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
                <Button Style="{StaticResource LinkButton}" Content="Custom voice line…" HorizontalAlignment="Left" Margin="0,4,0,0"
                        Command="{Binding EditVoiceLineCommand}" Click="CustomVoiceLine_Click"
                        Visibility="{Binding EditingVoiceLine, Converter={StaticResource InverseBoolToVisibility}}" />
                <StackPanel Margin="0,8,0,0" Visibility="{Binding EditingVoiceLine, Converter={StaticResource BoolToVisibility}}">
                    <TextBox x:Name="VoiceLineBox" Text="{Binding VoiceLine, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                             controls:Ui.HasError="{Binding VoiceLineInvalid}" AutomationProperties.Name="Voice line" />
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Generate" VerticalAlignment="Center"
                                Command="{Binding GenerateVoiceLineCommand}" Click="Generate_Click" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Reset" Margin="0,0,14,0" VerticalAlignment="Center"
                                Command="{Binding ResetVoiceLineCommand}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Content="+ Name" Padding="10,3" FontSize="12" Focusable="False" Click="InsertName_Click" />
                            <Button Style="{StaticResource GhostButton}" Content="+ Time left" Padding="10,3" FontSize="12" Margin="6,0,0,0"
                                    Focusable="False" Click="InsertTime_Click" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE768;" Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,0"
                                    ToolTip="Play" Command="{Binding HearVoiceLineCommand}" />
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar Height="3" IsIndeterminate="{Binding Generating}" Margin="0,8,0,0"
                                 Visibility="{Binding Generating, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding GenerationError}" Style="{StaticResource ErrorText}"
                               Visibility="{Binding GenerationError, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Row}">
            <DockPanel>
                <controls:CycleSelector DockPanel.Dock="Right" ItemsSource="{Binding OverlayChoices}" SelectedItem="{Binding Overlay}" ValueWidth="110"
                                        AutomationProperties.Name="Overlay over the game" />
                <TextBlock Text="Overlay over the game" Style="{StaticResource RowLabel}" ToolTip="{Binding OverlayTip}" />
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
