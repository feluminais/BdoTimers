<UserControl x:Class="BdoTimers.App.Views.Panels.AlertRows"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BdoTimers.App.Controls"
             xmlns:panels="clr-namespace:BdoTimers.App.Views.Panels">
    <StackPanel>
        <Border Style="{StaticResource Row}">
            <StackPanel>
                <TextBlock Text="Alert before (minutes)" Style="{StaticResource RowLabel}" Margin="0,0,0,6" />
                <panels:LeadChips DataContext="{Binding Leads}" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Row}">
            <DockPanel>
                <controls:CycleSelector DockPanel.Dock="Right" ItemsSource="{Binding SoundChoices}" SelectedItem="{Binding Sound}" ValueWidth="110" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Sound" Style="{StaticResource RowLabel}" />
                    <TextBlock Text="{Binding SoundFileName}" Style="{StaticResource LabelText}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding SoundFileName, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Style="{StaticResource Row}">
            <DockPanel>
                <controls:CycleSelector DockPanel.Dock="Right" ItemsSource="{Binding OnOff}" SelectedItem="{Binding Toast}" ValueWidth="110" />
                <TextBlock Text="Windows notification" Style="{StaticResource RowLabel}" />
            </DockPanel>
        </Border>
        <Border Style="{StaticResource Row}">
            <StackPanel>
                <DockPanel>
                    <controls:CycleSelector DockPanel.Dock="Right" ItemsSource="{Binding OnOff}" SelectedItem="{Binding Voice}" ValueWidth="110" />
                    <TextBlock Text="Voice" Style="{StaticResource RowLabel}" />
                </DockPanel>
                <TextBox Text="{Binding VoicePhrase, UpdateSourceTrigger=PropertyChanged, Delay=400}" Margin="0,6,0,0" FontSize="12"
                         controls:Ui.HasError="{Binding VoicePhraseInvalid}" ToolTip="{}{name} and {duration} are filled in" />
                <TextBlock Text="{}{name} and {duration} are filled in, e.g. &quot;Kzarka in 5 minutes&quot;." Style="{StaticResource LabelText}" Margin="0,3,0,0" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Row}">
            <DockPanel>
                <controls:CycleSelector DockPanel.Dock="Right" ItemsSource="{Binding OverlayChoices}" SelectedItem="{Binding Overlay}" ValueWidth="110" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Overlay over the game" Style="{StaticResource RowLabel}" />
                    <TextBlock Text="Borderless window mode only" Style="{StaticResource LabelText}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
