<UserControl x:Class="BdoTimers.App.Views.Panels.TodoScheduleEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BdoTimers.App.Controls">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <controls:CycleSelector ItemsSource="{Binding Days}" SelectedItem="{Binding Day}" ValueWidth="100"
                                    Visibility="{Binding IsWeekly, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="Reset day" />
            <TextBox Text="{Binding Time, UpdateSourceTrigger=PropertyChanged}" Width="62" MaxLength="5"
                     Margin="8,0,0,0" HorizontalContentAlignment="Center" AutomationProperties.Name="Reset time"
                     controls:Ui.HasError="{Binding InvalidTime}" />
            <controls:CycleSelector ItemsSource="{Binding Zones}" SelectedItem="{Binding Zone}" ValueWidth="72"
                                    Margin="8,0,0,0" AutomationProperties.Name="Reset time zone" />
        </StackPanel>
    </StackPanel>
</UserControl>
