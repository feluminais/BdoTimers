<UserControl x:Class="BdoTimers.App.Views.Panels.NewTimerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="380">
    <StackPanel Margin="22,16,22,20">
        <DockPanel Margin="0,0,0,14">
            <Button DockPanel.Dock="Right" Style="{StaticResource PanelCloseButton}" />
            <TextBlock Text="New timer" Style="{StaticResource DisplayText}" FontSize="18" VerticalAlignment="Center" />
        </DockPanel>
        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="16,12" Command="{Binding CountdownCommand}"
                AutomationProperties.Name="Countdown">
            <TextBlock Text="Countdown" Style="{StaticResource DisplayText}" FontSize="14" Foreground="{DynamicResource TextBrush}" />
        </Button>
        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,10,0,0" Command="{Binding WeeklyCommand}"
                AutomationProperties.Name="Weekly">
            <TextBlock Text="Weekly" Style="{StaticResource DisplayText}" FontSize="14" Foreground="{DynamicResource TextBrush}" />
        </Button>
        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,10,0,0" Command="{Binding OneTimeCommand}"
                AutomationProperties.Name="One-time event">
            <TextBlock Text="One-time event" Style="{StaticResource DisplayText}" FontSize="14" Foreground="{DynamicResource TextBrush}" />
        </Button>
        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="16,12" Margin="0,10,0,0" Command="{Binding GuildBossCommand}"
                AutomationProperties.Name="Guild boss">
            <TextBlock Text="Guild boss" Style="{StaticResource DisplayText}" FontSize="14" Foreground="{StaticResource TextBrush}" />
        </Button>
    </StackPanel>
</UserControl>
