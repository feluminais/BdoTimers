<UserControl x:Class="BdoTimers.App.Views.Panels.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BdoTimers.App.Controls"
             xmlns:panels="clr-namespace:BdoTimers.App.Views.Panels"
             Width="460">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="22,16,12,4">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" ToolTip="Close"
                    Command="{Binding DataContext.ClosePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock Text="Settings" Style="{StaticResource DisplayText}" FontSize="18" VerticalAlignment="Center" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="22,8,22,16" LastChildFill="False">
            <Button Style="{StaticResource OutlineButton}" Content="Done" DockPanel.Dock="Right" IsDefault="True"
                    Command="{Binding DataContext.ClosePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="22,0,22,4">
                <TextBlock Text="General" Style="{StaticResource SectionText}" Margin="0,4,0,4" />
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <controls:CycleSelector DockPanel.Dock="Right" ItemsSource="{Binding OnOff}" SelectedItem="{Binding Autostart}" ValueWidth="110" />
                        <TextBlock Text="Start with Windows" Style="{StaticResource RowLabel}" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE768;" Foreground="{StaticResource AccentBrush}"
                                ToolTip="Test the alert sound" Command="{Binding PreviewSoundCommand}" />
                        <controls:CycleSelector DockPanel.Dock="Right" ItemsSource="{Binding AlertSounds}" SelectedItem="{Binding AlertSound}" ValueWidth="110"
                                                AutomationProperties.Name="Default sound" />
                        <TextBlock Text="Default sound" Style="{StaticResource RowLabel}" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <StackPanel>
                        <TextBlock Text="Default alert times (minutes before)" Style="{StaticResource RowLabel}" Margin="0,0,0,6" />
                        <panels:LeadChips DataContext="{Binding DefaultLeads}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="+ Add sound…" VerticalAlignment="Center"
                                    ToolTip="WAV or MP3" Command="{Binding AddSoundCommand}" />
                            <TextBlock Text="Your sounds" Style="{StaticResource RowLabel}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding UserSounds}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="12,0,0,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="9"
                                                Width="26" Height="26" ToolTip="Remove" Command="{Binding RemoveCommand}" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE768;"
                                                Foreground="{StaticResource AccentBrush}" Width="26" Height="26" ToolTip="Play"
                                                Command="{Binding PlayCommand}" />
                                        <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding SoundError}" Style="{StaticResource ErrorText}"
                                   Visibility="{Binding SoundError, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE768;" Foreground="{StaticResource AccentBrush}"
                                ToolTip="Test the volume" Command="{Binding PreviewSoundCommand}" />
                        <Slider DockPanel.Dock="Right" Width="170" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="0,0,8,0"
                                Value="{Binding Volume, Delay=250}" />
                        <TextBlock Text="Volume" Style="{StaticResource RowLabel}" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE768;" Foreground="{StaticResource AccentBrush}"
                                ToolTip="Test the voice" Command="{Binding TestVoiceCommand}" />
                        <controls:CycleSelector DockPanel.Dock="Right" ItemsSource="{Binding Voices}" SelectedItem="{Binding Voice}" ValueWidth="200"
                                                AutomationProperties.Name="Voice" />
                        <TextBlock Text="Voice" Style="{StaticResource RowLabel}" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <Slider DockPanel.Dock="Right" Width="170" Minimum="-5" Maximum="5" IsSnapToTickEnabled="True" TickFrequency="1"
                                VerticalAlignment="Center" Margin="0,0,40,0" Value="{Binding SpeechRate, Delay=250}" />
                        <TextBlock Text="Speech speed" Style="{StaticResource RowLabel}" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Send" Command="{Binding TestAlertCommand}"
                                AutomationProperties.Name="Send test alert" />
                        <TextBlock Text="Test alert" Style="{StaticResource RowLabel}" />
                    </DockPanel>
                </Border>

                <TextBlock Text="In game" Style="{StaticResource SectionText}" />
                <Border Style="{StaticResource Row}">
                    <StackPanel>
                        <WrapPanel Margin="0,4,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="Priority notifications" Margin="0,0,8,6"
                                    ToolTip="Add BDO Timers here so alerts show while you play fullscreen" Command="{Binding OpenNotificationSettingsCommand}" />
                            <Button Command="{Binding ToggleOverlayPositioningCommand}" Margin="0,0,8,6" ToolTip="Drag the overlay where it should appear in game">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Setter Property="Content" Value="Position overlay" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPositioningOverlay}" Value="True">
                                                <Setter Property="Content" Value="Save overlay position" />
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Bosses" Style="{StaticResource SectionText}" />
                <Border Style="{StaticResource Row}">
                    <StackPanel>
                        <Button Style="{StaticResource LinkButton}" Content="Reset all boss alert settings" HorizontalAlignment="Left"
                                Command="{Binding AskAlertResetCommand}"
                                Visibility="{Binding ConfirmingAlertReset, Converter={StaticResource InverseBoolToVisibility}}" />
                        <StackPanel Visibility="{Binding ConfirmingAlertReset, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Reset all boss alert settings?" Style="{StaticResource LabelText}" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource DangerLinkButton}" Content="Reset" Command="{Binding ConfirmAlertResetCommand}"
                                        AutomationProperties.Name="Reset alert settings" />
                                <TextBlock Text="·" Foreground="{StaticResource PastBrush}" Margin="8,0" VerticalAlignment="Center" />
                                <Button Style="{StaticResource LinkButton}" Content="Cancel" Command="{Binding CancelAlertResetCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <StackPanel>
                        <Button Style="{StaticResource LinkButton}" Content="Reset spawn times to the EU timetable" HorizontalAlignment="Left"
                                Command="{Binding AskResetCommand}"
                                Visibility="{Binding ConfirmingReset, Converter={StaticResource InverseBoolToVisibility}}" />
                        <StackPanel Visibility="{Binding ConfirmingReset, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Reset spawn times to the EU timetable?" Style="{StaticResource LabelText}" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource DangerLinkButton}" Content="Reset" Command="{Binding ConfirmResetCommand}"
                                        AutomationProperties.Name="Reset spawn times" />
                                <TextBlock Text="·" Foreground="{StaticResource PastBrush}" Margin="8,0" VerticalAlignment="Center" />
                                <Button Style="{StaticResource LinkButton}" Content="Cancel" Command="{Binding CancelResetCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="About" Style="{StaticResource SectionText}" />
                <Border Style="{StaticResource Row}">
                    <StackPanel>
                        <TextBlock FontSize="12">
                            <Run Text="BDO Timers" /> <Run Text="{Binding Version, Mode=OneWay}" Foreground="{StaticResource SubtleBrush}" />
                        </TextBlock>
                        <TextBlock Text="© 2026 feluminais · Free software under GPL-3.0, with no warranty." Style="{StaticResource LabelText}" Margin="0,2,0,0" />
                        <TextBlock Text="Not affiliated with Pearl Abyss. Game artwork © Pearl Abyss." Style="{StaticResource LabelText}" Margin="0,2,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource LinkButton}" Content="Source code" Command="{Binding OpenSourceCommand}" />
                            <TextBlock Text="·" Foreground="{StaticResource PastBrush}" Margin="8,0" VerticalAlignment="Center" />
                            <Button Style="{StaticResource LinkButton}" Content="Licenses" Command="{Binding OpenLicensesCommand}" />
                            <TextBlock Text="·" Foreground="{StaticResource PastBrush}" Margin="8,0" VerticalAlignment="Center" />
                            <Button Style="{StaticResource LinkButton}" Content="Open data folder" Command="{Binding OpenDataFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
