<UserControl x:Class="BdoTimers.App.Views.Panels.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BdoTimers.App.Controls"
             xmlns:panels="clr-namespace:BdoTimers.App.Views.Panels"
             Width="460">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="22,16,12,4">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10" ToolTip="Close"
                    Command="{Binding DataContext.ClosePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock Text="Settings" Style="{StaticResource DisplayText}" FontSize="18" VerticalAlignment="Center" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="22,8,22,16" LastChildFill="False">
            <Button Style="{StaticResource OutlineButton}" Content="Done" DockPanel.Dock="Right" IsDefault="True"
                    Command="{Binding DataContext.ClosePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="22,0,22,4">
                <TextBlock Text="General" Style="{StaticResource SectionText}" Margin="0,4,0,4" />
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <controls:CycleSelector DockPanel.Dock="Right" ItemsSource="{Binding OnOff}" SelectedItem="{Binding CloseToTray}"
                                                ValueWidth="110" AutomationProperties.Name="Close to tray" />
                        <TextBlock Text="Close to tray" Style="{StaticResource RowLabel}" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <controls:CycleSelector DockPanel.Dock="Right" ItemsSource="{Binding OnOff}" SelectedItem="{Binding Autostart}" ValueWidth="110" />
                        <TextBlock Text="Start with Windows" Style="{StaticResource RowLabel}" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <StackPanel>
                        <TextBlock Text="Default alert times (minutes before)" Style="{StaticResource RowLabel}" Margin="0,0,0,6" />
                        <panels:LeadChips DataContext="{Binding DefaultLeads}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Test sound" Margin="8,0,0,0" Width="112"
                                VerticalAlignment="Center" Command="{Binding PreviewSoundCommand}" />
                        <controls:CycleSelector DockPanel.Dock="Right" ItemsSource="{Binding AlertSounds}" SelectedItem="{Binding AlertSound}" ValueWidth="130"
                                                AutomationProperties.Name="Default sound" />
                        <TextBlock Text="Default sound" Style="{StaticResource RowLabel}" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="+ Add sound…" VerticalAlignment="Center"
                                    ToolTip="WAV or MP3" Command="{Binding AddSoundCommand}" />
                            <TextBlock Text="Your sounds" Style="{StaticResource RowLabel}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding UserSounds}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="12,0,0,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="9"
                                                Width="26" Height="26" ToolTip="Remove" Command="{Binding RemoveCommand}" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE768;"
                                                Foreground="{StaticResource AccentBrush}" Width="26" Height="26" ToolTip="Play"
                                                Command="{Binding PlayCommand}" />
                                        <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding SoundError}" Style="{StaticResource ErrorText}"
                                   Visibility="{Binding SoundError, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <Slider DockPanel.Dock="Right" Width="170" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                Value="{Binding Volume, Delay=250}" />
                        <TextBlock Text="Volume" Style="{StaticResource RowLabel}" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Test voice" Margin="8,0,0,0" Width="112"
                                VerticalAlignment="Center" Command="{Binding TestVoiceCommand}" />
                        <controls:CycleSelector DockPanel.Dock="Right" ItemsSource="{Binding Voices}" SelectedItem="{Binding Voice}" ValueWidth="130"
                                                AutomationProperties.Name="Voice" />
                        <TextBlock Text="Voice" Style="{StaticResource RowLabel}" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <Slider DockPanel.Dock="Right" Width="170" Minimum="-5" Maximum="5" IsSnapToTickEnabled="True" TickFrequency="1"
                                VerticalAlignment="Center" Value="{Binding SpeechRate, Delay=250}" />
                        <TextBlock Text="Speech speed" Style="{StaticResource RowLabel}" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Send" Command="{Binding TestAlertCommand}"
                                AutomationProperties.Name="Send test alert" />
                        <TextBlock Text="Test alert" Style="{StaticResource RowLabel}" />
                    </DockPanel>
                </Border>

                <TextBlock Text="To-do" Style="{StaticResource SectionText}" />
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <panels:TodoScheduleEditor DockPanel.Dock="Right" DataContext="{Binding DailyTodoReset}" />
                        <TextBlock Text="Daily reset" Style="{StaticResource RowLabel}" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <panels:TodoScheduleEditor DockPanel.Dock="Right" DataContext="{Binding WeeklyTodoReset}" />
                        <TextBlock Text="Weekly reset" Style="{StaticResource RowLabel}" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Row}" Visibility="{Binding HasDeletedTodoDefaults, Converter={StaticResource BoolToVisibility}}">
                    <Button Style="{StaticResource LinkButton}" Content="Restore default lists" HorizontalAlignment="Left"
                            Command="{Binding RestoreTodoDefaultsCommand}" />
                </Border>

                <TextBlock Text="In game" Style="{StaticResource SectionText}" />
                <Border Style="{StaticResource Row}">
                    <StackPanel>
                        <WrapPanel Margin="0,4,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="Priority notifications" Margin="0,0,8,6"
                                    ToolTip="Add BDO Timers here so alerts show while you play fullscreen" Command="{Binding OpenNotificationSettingsCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Bosses" Style="{StaticResource SectionText}" />
                <Border Style="{StaticResource Row}">
                    <StackPanel>
                        <DockPanel>
                            <controls:CycleSelector DockPanel.Dock="Right" ItemsSource="{Binding Regions}" SelectedItem="{Binding Region}"
                                                    ValueWidth="160" AutomationProperties.Name="Boss region" />
                            <TextBlock Text="Region" Style="{StaticResource RowLabel}" />
                        </DockPanel>
                        <TextBlock Text="{Binding RegionError}" Style="{StaticResource LabelText}"
                                   Visibility="{Binding RegionError, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <StackPanel>
                        <TextBlock Text="{Binding TimetableVerified}" Style="{StaticResource LabelText}" ToolTip="{Binding TimetableSource}" />
                        <Button Style="{StaticResource LinkButton}" Content="Review timetable changes" HorizontalAlignment="Left" Margin="0,6,0,0"
                                Command="{Binding ReviewTimetableCommand}"
                                Visibility="{Binding NeedsTimetableReview, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Margin="0,6,0,0" Visibility="{Binding ReviewingTimetable, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding TimetableZone}" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding TimetableChanges}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4,0,8">
                                            <DockPanel>
                                                <controls:CycleSelector DockPanel.Dock="Right" ItemsSource="{Binding OnOff}" SelectedItem="{Binding Apply}"
                                                                        ValueWidth="65" AutomationProperties.Name="Apply timetable change" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="12" />
                                                    <TextBlock Text="{Binding CustomLabel}" FontSize="11" Foreground="{StaticResource AccentBrush}"
                                                               Visibility="{Binding CustomLabel, Converter={StaticResource NullToCollapsed}}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Details}" Style="{StaticResource LabelText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Style="{StaticResource LinkButton}" Content="Apply selected" Command="{Binding ApplyTimetableCommand}" Margin="0,0,12,6" />
                                <Button Style="{StaticResource LinkButton}" Content="Keep current times" Command="{Binding KeepTimetableCommand}" Margin="0,0,12,6" />
                                <Button Style="{StaticResource LinkButton}" Content="Cancel" Command="{Binding CancelTimetableCommand}" Margin="0,0,0,6" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <StackPanel>
                        <Button Style="{StaticResource LinkButton}" Content="{Binding ResetAlertLabel}" HorizontalAlignment="Left"
                                Command="{Binding AskAlertResetCommand}"
                                Visibility="{Binding ConfirmingAlertReset, Converter={StaticResource InverseBoolToVisibility}}" />
                        <StackPanel Visibility="{Binding ConfirmingAlertReset, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ResetAlertConfirmation}" Style="{StaticResource LabelText}" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource DangerLinkButton}" Content="Reset" Command="{Binding ConfirmAlertResetCommand}"
                                        AutomationProperties.Name="Reset alert settings" />
                                <TextBlock Text="·" Foreground="{StaticResource PastBrush}" Margin="8,0" VerticalAlignment="Center" />
                                <Button Style="{StaticResource LinkButton}" Content="Cancel" Command="{Binding CancelAlertResetCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <StackPanel>
                        <Button Style="{StaticResource LinkButton}" Content="{Binding ResetTimetableLabel}" HorizontalAlignment="Left"
                                Command="{Binding AskResetCommand}"
                                Visibility="{Binding ConfirmingReset, Converter={StaticResource InverseBoolToVisibility}}" />
                        <StackPanel Visibility="{Binding ConfirmingReset, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ResetTimetableConfirmation}" Style="{StaticResource LabelText}" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource DangerLinkButton}" Content="Reset" Command="{Binding ConfirmResetCommand}"
                                        AutomationProperties.Name="Reset spawn times" />
                                <TextBlock Text="·" Foreground="{StaticResource PastBrush}" Margin="8,0" VerticalAlignment="Center" />
                                <Button Style="{StaticResource LinkButton}" Content="Cancel" Command="{Binding CancelResetCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Data" Style="{StaticResource SectionText}" />
                <Border Style="{StaticResource Row}">
                    <StackPanel>
                        <WrapPanel>
                            <Button Style="{StaticResource LinkButton}" Content="Export backup…" Command="{Binding ExportBackupCommand}" Margin="0,0,14,6" />
                            <Button Style="{StaticResource LinkButton}" Content="Restore backup…" Command="{Binding ChooseRestoreCommand}" Margin="0,0,14,6" />
                            <Button Style="{StaticResource LinkButton}" Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="0,0,0,6" />
                        </WrapPanel>
                        <TextBlock Text="{Binding DataStatus}" Style="{StaticResource LabelText}" TextWrapping="Wrap"
                                   Visibility="{Binding DataStatus, Converter={StaticResource NullToCollapsed}}" />
                        <StackPanel Visibility="{Binding ConfirmingRestore, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                            <TextBlock Text="{Binding RestoreDescription}" Style="{StaticResource LabelText}" TextWrapping="Wrap" />
                            <TextBlock Text="Replace current data and restart?" FontSize="12" Margin="0,6,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource DangerLinkButton}" Content="Restore" Command="{Binding ConfirmRestoreCommand}" />
                                <TextBlock Text="·" Foreground="{StaticResource PastBrush}" Margin="8,0" VerticalAlignment="Center" />
                                <Button Style="{StaticResource LinkButton}" Content="Cancel" Command="{Binding CancelRestoreCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="About" Style="{StaticResource SectionText}" />
                <Border Style="{StaticResource Row}">
                    <StackPanel>
                        <TextBlock FontSize="12">
                            <Run Text="BDO Timers" /> <Run Text="{Binding Version, Mode=OneWay}" Foreground="{StaticResource SubtleBrush}" />
                        </TextBlock>
                        <TextBlock Text="© 2026 feluminais · Free software under GPL-3.0, with no warranty." Style="{StaticResource LabelText}" Margin="0,2,0,0" />
                        <TextBlock Text="Not affiliated with Pearl Abyss. Game artwork © Pearl Abyss." Style="{StaticResource LabelText}" Margin="0,2,0,6" />
                        <WrapPanel Margin="0,0,0,6">
                            <Button Style="{StaticResource LinkButton}" Content="Check for updates" Command="{Binding CheckForUpdatesCommand}" Margin="0,0,14,0" />
                            <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,8,0"
                                       AutomationProperties.LiveSetting="Polite" Visibility="{Binding UpdateStatus, Converter={StaticResource NullToCollapsed}}" />
                            <TextBlock Text="{Binding AvailableVersion}" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"
                                       Visibility="{Binding AvailableVersion, Converter={StaticResource NullToCollapsed}}" />
                            <Button Style="{StaticResource LinkButton}" Content="View release" Command="{Binding OpenReleaseCommand}"
                                    Visibility="{Binding AvailableVersion, Converter={StaticResource NullToCollapsed}}" />
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource LinkButton}" Content="Source code" Command="{Binding OpenSourceCommand}" />
                            <TextBlock Text="·" Foreground="{StaticResource PastBrush}" Margin="8,0" VerticalAlignment="Center" />
                            <Button Style="{StaticResource LinkButton}" Content="Licenses" Command="{Binding OpenLicensesCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
