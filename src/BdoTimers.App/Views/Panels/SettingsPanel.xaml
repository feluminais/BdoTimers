<UserControl x:Class="BdoTimers.App.Views.Panels.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BdoTimers.App.Controls"
             xmlns:panels="clr-namespace:BdoTimers.App.Views.Panels"
             Width="460">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="22,16,12,4">
            <Button DockPanel.Dock="Right" Style="{StaticResource PanelCloseButton}" />
            <TextBlock Text="Settings" Style="{StaticResource DisplayText}" FontSize="18" VerticalAlignment="Center" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="22,8,22,16" LastChildFill="False">
            <Button Style="{StaticResource PanelDoneButton}" IsDefault="True" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="22,0,22,4">
                <TextBlock Text="General" Style="{StaticResource SectionText}" Margin="0,4,0,4" />
                <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Close to tray">
                    <controls:CycleSelector ItemsSource="{Binding OnOff}" SelectedItem="{Binding CloseToTray}"
                                            ValueWidth="110" AutomationProperties.Name="Close to tray" />
                </HeaderedContentControl>
                <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Start with Windows">
                    <controls:CycleSelector ItemsSource="{Binding OnOff}" SelectedItem="{Binding Autostart}" ValueWidth="110" />
                </HeaderedContentControl>
                <Border Style="{StaticResource Row}">
                    <StackPanel>
                        <TextBlock Text="Default alert times (minutes before)" Style="{StaticResource RowLabel}" Margin="0,0,0,6" />
                        <panels:LeadChips DataContext="{Binding DefaultLeads}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Test sound" Margin="8,0,0,0" Width="112"
                                VerticalAlignment="Center" Command="{Binding PreviewSoundCommand}" />
                        <controls:CycleSelector DockPanel.Dock="Right" ItemsSource="{Binding AlertSounds}" SelectedItem="{Binding AlertSound}" ValueWidth="130"
                                                AutomationProperties.Name="Default sound" />
                        <TextBlock Text="Default sound" Style="{StaticResource RowLabel}" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="+ Add sound…" VerticalAlignment="Center"
                                    ToolTip="WAV or MP3" Command="{Binding AddSoundCommand}" />
                            <TextBlock Text="Your sounds" Style="{StaticResource RowLabel}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding UserSounds}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="12,0,0,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="9"
                                                Width="26" Height="26" ToolTip="Remove" Command="{Binding RemoveCommand}" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE768;"
                                                Foreground="{StaticResource AccentBrush}" Width="26" Height="26" ToolTip="Play"
                                                Command="{Binding PlayCommand}" />
                                        <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding SoundError}" Style="{StaticResource ErrorText}"
                                   Visibility="{Binding SoundError, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>
                <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Volume">
                    <Slider Width="170" Minimum="0" Maximum="1" VerticalAlignment="Center" Value="{Binding Volume, Delay=250}" />
                </HeaderedContentControl>
                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Test voice" Margin="8,0,0,0" Width="112"
                                VerticalAlignment="Center" Command="{Binding TestVoiceCommand}" />
                        <controls:CycleSelector DockPanel.Dock="Right" ItemsSource="{Binding Voices}" SelectedItem="{Binding Voice}" ValueWidth="130"
                                                AutomationProperties.Name="Voice" />
                        <TextBlock Text="Voice" Style="{StaticResource RowLabel}" />
                    </DockPanel>
                </Border>
                <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Speech speed">
                    <Slider Width="170" Minimum="-5" Maximum="5" IsSnapToTickEnabled="True" TickFrequency="1"
                            VerticalAlignment="Center" Value="{Binding SpeechRate, Delay=250}" />
                </HeaderedContentControl>
                <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Test alert">
                    <Button Style="{StaticResource GhostButton}" Content="Send" Command="{Binding TestAlertCommand}"
                            AutomationProperties.Name="Send test alert" />
                </HeaderedContentControl>

                <TextBlock Text="To-do" Style="{StaticResource SectionText}" />
                <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Daily reset">
                    <panels:TodoScheduleEditor DataContext="{Binding DailyTodoReset}" />
                </HeaderedContentControl>
                <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Weekly reset">
                    <panels:TodoScheduleEditor DataContext="{Binding WeeklyTodoReset}" />
                </HeaderedContentControl>
                <Border Style="{StaticResource Row}" Visibility="{Binding HasDeletedTodoDefaults, Converter={StaticResource BoolToVisibility}}">
                    <Button Style="{StaticResource LinkButton}" Content="Restore default lists" HorizontalAlignment="Left"
                            Command="{Binding RestoreTodoDefaultsCommand}" />
                </Border>

                <TextBlock Text="In game" Style="{StaticResource SectionText}" />
                <Border Style="{StaticResource Row}">
                    <StackPanel>
                        <WrapPanel Margin="0,4,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="Priority notifications" Margin="0,0,8,6"
                                    ToolTip="Add BDO Timers here so alerts show while you play fullscreen" Command="{Binding OpenNotificationSettingsCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Bosses" Style="{StaticResource SectionText}" />
                <Border Style="{StaticResource Row}">
                    <StackPanel DataContext="{Binding AlertReset}">
                        <Button Style="{StaticResource LinkButton}" Content="Reset all boss alert settings" HorizontalAlignment="Left"
                                Command="{Binding AskCommand}"
                                Visibility="{Binding IsAsking, Converter={StaticResource InverseBoolToVisibility}}" />
                        <StackPanel Visibility="{Binding IsAsking, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Reset all boss alert settings?" Style="{StaticResource LabelText}" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource DangerLinkButton}" Content="Reset" Command="{Binding ConfirmCommand}"
                                        AutomationProperties.Name="Reset alert settings" />
                                <TextBlock Text="·" Foreground="{StaticResource PastBrush}" Margin="8,0" VerticalAlignment="Center" />
                                <Button Style="{StaticResource LinkButton}" Content="Cancel" Command="{Binding CancelCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Row}">
                    <StackPanel DataContext="{Binding TimetableReset}">
                        <Button Style="{StaticResource LinkButton}" Content="Reset spawn times to the EU timetable" HorizontalAlignment="Left"
                                Command="{Binding AskCommand}"
                                Visibility="{Binding IsAsking, Converter={StaticResource InverseBoolToVisibility}}" />
                        <StackPanel Visibility="{Binding IsAsking, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Reset spawn times to the EU timetable?" Style="{StaticResource LabelText}" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource DangerLinkButton}" Content="Reset" Command="{Binding ConfirmCommand}"
                                        AutomationProperties.Name="Reset spawn times" />
                                <TextBlock Text="·" Foreground="{StaticResource PastBrush}" Margin="8,0" VerticalAlignment="Center" />
                                <Button Style="{StaticResource LinkButton}" Content="Cancel" Command="{Binding CancelCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="About" Style="{StaticResource SectionText}" />
                <Border Style="{StaticResource Row}">
                    <StackPanel>
                        <TextBlock FontSize="12">
                            <Run Text="BDO Timers" /> <Run Text="{Binding Version, Mode=OneWay}" Foreground="{StaticResource SubtleBrush}" />
                        </TextBlock>
                        <TextBlock Text="© 2026 feluminais · Free software under GPL-3.0, with no warranty." Style="{StaticResource LabelText}" Margin="0,2,0,0" />
                        <TextBlock Text="Not affiliated with Pearl Abyss. Game artwork © Pearl Abyss." Style="{StaticResource LabelText}" Margin="0,2,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource LinkButton}" Content="Source code" Command="{Binding OpenSourceCommand}" />
                            <TextBlock Text="·" Foreground="{StaticResource PastBrush}" Margin="8,0" VerticalAlignment="Center" />
                            <Button Style="{StaticResource LinkButton}" Content="Licenses" Command="{Binding OpenLicensesCommand}" />
                            <TextBlock Text="·" Foreground="{StaticResource PastBrush}" Margin="8,0" VerticalAlignment="Center" />
                            <Button Style="{StaticResource LinkButton}" Content="Open data folder" Command="{Binding OpenDataFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
