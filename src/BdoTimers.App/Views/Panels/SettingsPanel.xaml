<UserControl x:Class="BdoTimers.App.Views.Panels.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BdoTimers.App.Controls"
             xmlns:panels="clr-namespace:BdoTimers.App.Views.Panels"
             MaxWidth="460" HorizontalAlignment="Stretch" PreviewKeyDown="Panel_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="SearchRow" TargetType="Border" BasedOn="{StaticResource Row}">
            <Style.Triggers>
                <Trigger Property="panels:SettingsFilter.IsMatch" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SearchSettingRow" TargetType="HeaderedContentControl" BasedOn="{StaticResource SettingRow}">
            <Style.Triggers>
                <Trigger Property="panels:SettingsFilter.IsMatch" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SearchHeading" TargetType="TextBlock" BasedOn="{StaticResource SectionText}">
            <Style.Triggers>
                <Trigger Property="panels:SettingsFilter.IsMatch" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <DockPanel Margin="22,16,12,4">
                <Button DockPanel.Dock="Right" Style="{StaticResource PanelCloseButton}" />
                <TextBlock Text="Settings" Style="{StaticResource DisplayText}" FontSize="18" VerticalAlignment="Center" />
            </DockPanel>
            <DockPanel Margin="22,0,22,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE894;" ToolTip="Clear search"
                        Width="28" Height="28" Click="ClearSearch_Click" />
                <TextBlock Text="Search" Foreground="{DynamicResource SubtleBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBox controls:Ui.InitialFocus="True" x:Name="SearchBox" AutomationProperties.Name="Search settings" ToolTip="Search settings (Ctrl+F)"
                         TextChanged="SearchBox_TextChanged" />
            </DockPanel>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="22,8,22,16" LastChildFill="False">
            <Button Style="{StaticResource PanelDoneButton}" Content="Save" IsDefault="True" IsEnabled="{Binding CanFinish}" />
        </DockPanel>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="22,0,22,4">
                <TextBlock x:Name="NoResults" Text="No settings found" Foreground="{DynamicResource SubtleBrush}"
                           Margin="0,12,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                <StackPanel x:Name="SettingsItems">
                <TextBlock Text="Appearance" Style="{StaticResource SearchHeading}" Margin="0,4,0,4" />
                <HeaderedContentControl Style="{StaticResource SearchSettingRow}" Header="Text size" Tag="Text size display font accessibility scale Windows">
                    <controls:CycleSelector ItemsSource="{Binding TextSizes}" SelectedItem="{Binding TextSize}" ValueWidth="110"
                                            AutomationProperties.Name="Text size" />
                </HeaderedContentControl>
                <TextBlock Text="General" Style="{StaticResource SearchHeading}" Margin="0,4,0,4" />
                <HeaderedContentControl Style="{StaticResource SearchSettingRow}" Header="Close to tray" Tag="Close to tray">
                    <ToggleButton Style="{StaticResource OnOffSwitch}" IsChecked="{Binding CloseToTray}"
                                            Width="110" AutomationProperties.Name="Close to tray" />
                </HeaderedContentControl>
                <Border Style="{StaticResource SearchRow}" Tag="Start with Windows autostart startup">
                    <StackPanel>
                        <DockPanel>
                            <ToggleButton Style="{StaticResource OnOffSwitch}" DockPanel.Dock="Right" IsChecked="{Binding Autostart}"
                                                    Width="110" AutomationProperties.Name="Start with Windows" />
                            <TextBlock Text="Start with Windows" Style="{StaticResource RowLabel}" TextWrapping="Wrap" Margin="0,0,10,0" />
                        </DockPanel>
                        <TextBlock Text="{Binding AutostartError}" Style="{StaticResource ErrorText}"
                                   Visibility="{Binding AutostartError, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SearchRow}" Tag="Default alert times (minutes before)">
                    <StackPanel>
                        <TextBlock Text="Default alert times (minutes before)" Style="{StaticResource RowLabel}" Margin="0,0,0,6" />
                        <panels:LeadChips DataContext="{Binding DefaultLeads}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SearchRow}" Tag="Default sound Test sound">
                    <StackPanel>
                        <TextBlock Text="Default sound" Style="{StaticResource RowLabel}" Margin="0,0,0,4" />
                        <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Test sound" Margin="8,0,0,0"
                                VerticalAlignment="Center" Command="{Binding PreviewSoundCommand}" />
                        <ComboBox DisplayMemberPath="Label" HorizontalAlignment="Left" ItemsSource="{Binding AlertSounds}" SelectedItem="{Binding AlertSound}" Width="130"
                                                AutomationProperties.Name="Default sound" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SearchRow}" Tag="Your sounds + Add sound…">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="+ Add sound…" VerticalAlignment="Center"
                                    ToolTip="WAV or MP3" Command="{Binding AddSoundCommand}" />
                            <TextBlock Text="Your sounds" Style="{StaticResource RowLabel}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding UserSounds}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="12,0,0,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="9"
                                                Width="26" Height="26" ToolTip="Remove" Command="{Binding RemoveCommand}" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE768;"
                                                Foreground="{DynamicResource AccentBrush}" Width="26" Height="26" ToolTip="Play"
                                                Command="{Binding PlayCommand}" />
                                        <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding SoundError}" Style="{StaticResource ErrorText}"
                                   Visibility="{Binding SoundError, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>
                <HeaderedContentControl Style="{StaticResource SearchSettingRow}" Header="Volume" Tag="Volume audio sound loudness">
                    <Slider AutomationProperties.Name="Volume" Width="170" Minimum="0" Maximum="1" VerticalAlignment="Center" Value="{Binding Volume, Delay=250}" />
                </HeaderedContentControl>
                <Border Style="{StaticResource SearchRow}" Tag="Voice test speech TTS">
                    <StackPanel>
                        <TextBlock Text="Voice" Style="{StaticResource RowLabel}" Margin="0,0,0,4" />
                        <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Test voice" Margin="8,0,0,0"
                                VerticalAlignment="Center" Command="{Binding TestVoiceCommand}" />
                        <ComboBox DisplayMemberPath="Label" HorizontalAlignment="Left" ItemsSource="{Binding Voices}" SelectedItem="{Binding Voice}" Width="130"
                                                AutomationProperties.Name="Voice" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <HeaderedContentControl Style="{StaticResource SearchSettingRow}" Header="Speech speed" Tag="Speech speed rate TTS">
                    <Slider AutomationProperties.Name="Speech speed" Width="170" Minimum="-5" Maximum="5" IsSnapToTickEnabled="True" TickFrequency="1"
                            VerticalAlignment="Center" Value="{Binding SpeechRate, Delay=250}" />
                </HeaderedContentControl>
                <HeaderedContentControl Style="{StaticResource SearchSettingRow}" Header="Test alert" Tag="Test alert Send Send test alert">
                    <StackPanel>
                        <Button Content="Send" Command="{Binding TestAlertCommand}" HorizontalAlignment="Right"
                                AutomationProperties.Name="Send test alert">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Health.TestBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Text="{Binding Health.TestStatus}" Style="{StaticResource LabelText}" Margin="0,4,0,0"
                                   Visibility="{Binding Health.TestStatus, Converter={StaticResource NullToCollapsed}}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </HeaderedContentControl>

                <TextBlock Text="To-do" Style="{StaticResource SearchHeading}" Tag="todo tasks" />
                <HeaderedContentControl Style="{StaticResource SearchSettingRow}" Header="Daily reset" Tag="Daily reset time UTC local">
                    <panels:TodoScheduleEditor DataContext="{Binding DailyTodoReset}" />
                </HeaderedContentControl>
                <HeaderedContentControl Style="{StaticResource SearchSettingRow}" Header="Weekly reset" Tag="Weekly reset day time UTC local">
                    <panels:TodoScheduleEditor DataContext="{Binding WeeklyTodoReset}" />
                </HeaderedContentControl>
                <Border Style="{StaticResource SearchRow}" Tag="Restore default lists">
                    <Button Style="{StaticResource LinkButton}" Content="Restore default lists" HorizontalAlignment="Left"
                            Command="{Binding RestoreTodoDefaultsCommand}" IsEnabled="{Binding HasDeletedTodoDefaults}" />
                </Border>

                <TextBlock Text="In game" Style="{StaticResource SearchHeading}" Tag="notification fullscreen priority" />
                <Border Style="{StaticResource SearchRow}" Tag="Priority notifications">
                    <Button Style="{StaticResource GhostButton}" Content="Priority notifications" HorizontalAlignment="Left" Margin="0,4,8,6"
                            ToolTip="Add BDO Timers here so alerts show while you play fullscreen" Command="{Binding OpenNotificationSettingsCommand}" />
                </Border>

                <TextBlock x:Name="BossesHeading" Text="Bosses" Style="{StaticResource SearchHeading}" />
                <Border Style="{StaticResource SearchRow}" Tag="Boss region server Europe North America Asia">
                    <StackPanel>
                        <DockPanel>
                            <controls:CycleSelector DockPanel.Dock="Right" ItemsSource="{Binding Regions}" SelectedItem="{Binding Region}"
                                                    ValueWidth="160" AutomationProperties.Name="Boss region" />
                            <TextBlock Text="Region" Style="{StaticResource RowLabel}" />
                        </DockPanel>
                        <TextBlock Text="{Binding RegionError}" Style="{StaticResource LabelText}"
                                   Visibility="{Binding RegionError, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SearchRow}" Tag="Timetable verified source changes spawn times review apply keep">
                    <StackPanel>
                        <TextBlock Text="{Binding TimetableVerified}" Style="{StaticResource LabelText}" ToolTip="{Binding TimetableSource}" />
                        <Button Style="{StaticResource LinkButton}" Content="Review timetable changes" HorizontalAlignment="Left" Margin="0,6,0,0"
                                Command="{Binding ReviewTimetableCommand}" IsEnabled="{Binding RegionSaved}"
                                Visibility="{Binding NeedsTimetableReview, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Margin="0,6,0,0" Visibility="{Binding ReviewingTimetable, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding TimetableZone}" Style="{StaticResource LabelText}" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding TimetableChanges}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4,0,8">
                                            <DockPanel>
                                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource OnOffSwitch}" IsChecked="{Binding Apply}"
                                                                        Width="65" AutomationProperties.Name="Apply timetable change" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="12" />
                                                    <TextBlock Text="{Binding CustomLabel}" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                                               Visibility="{Binding CustomLabel, Converter={StaticResource NullToCollapsed}}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Details}" Style="{StaticResource LabelText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Style="{StaticResource LinkButton}" Content="Apply selected" Command="{Binding ApplyTimetableCommand}" IsEnabled="{Binding RegionSaved}" Margin="0,0,12,6" />
                                <Button Style="{StaticResource LinkButton}" Content="Keep current times" Command="{Binding KeepTimetableCommand}" IsEnabled="{Binding RegionSaved}" Margin="0,0,12,6" />
                                <Button Style="{StaticResource LinkButton}" Content="Cancel" Command="{Binding CancelTimetableCommand}" Margin="0,0,0,6" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SearchRow}" Tag="· Reset Cancel Reset alert settings reset boss alert settings">
                    <StackPanel>
                        <Button Style="{StaticResource LinkButton}" Content="{Binding ResetAlertLabel}" HorizontalAlignment="Left"
                                Command="{Binding AlertReset.AskCommand}" IsEnabled="{Binding RegionSaved}"
                                Visibility="{Binding AlertReset.IsAsking, Converter={StaticResource InverseBoolToVisibility}}" />
                        <StackPanel Visibility="{Binding AlertReset.IsAsking, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ResetAlertConfirmation}" Style="{StaticResource LabelText}" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource DangerLinkButton}" Content="Reset" Command="{Binding AlertReset.ConfirmCommand}" IsEnabled="{Binding RegionSaved}"
                                        AutomationProperties.Name="Reset alert settings" />
                                <TextBlock Text="·" Foreground="{DynamicResource PastBrush}" Margin="8,0" VerticalAlignment="Center" />
                                <Button Style="{StaticResource LinkButton}" Content="Cancel" Command="{Binding AlertReset.CancelCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SearchRow}" Tag="· Reset Cancel Reset spawn times reset spawn times timetable">
                    <StackPanel>
                        <Button Style="{StaticResource LinkButton}" Content="{Binding ResetTimetableLabel}" HorizontalAlignment="Left"
                                Command="{Binding TimetableReset.AskCommand}" IsEnabled="{Binding RegionSaved}" ToolTip="Brings back removed bosses and their spawn times; bosses you added stay"
                                Visibility="{Binding TimetableReset.IsAsking, Converter={StaticResource InverseBoolToVisibility}}" />
                        <StackPanel Visibility="{Binding TimetableReset.IsAsking, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ResetTimetableConfirmation}" Style="{StaticResource LabelText}" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource DangerLinkButton}" Content="Reset" Command="{Binding TimetableReset.ConfirmCommand}" IsEnabled="{Binding RegionSaved}"
                                        AutomationProperties.Name="Reset bosses" />
                                <TextBlock Text="·" Foreground="{DynamicResource PastBrush}" Margin="8,0" VerticalAlignment="Center" />
                                <Button Style="{StaticResource LinkButton}" Content="Cancel" Command="{Binding TimetableReset.CancelCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Data" Style="{StaticResource SearchHeading}" />
                <Border Style="{StaticResource SearchRow}" Tag="Replace current data and restart? · Export backup… Restore backup… Open data folder Restore Cancel">
                    <StackPanel>
                        <WrapPanel>
                            <Button Style="{StaticResource LinkButton}" Content="Export backup…" Command="{Binding ExportBackupCommand}" Margin="0,0,14,6" />
                            <Button Style="{StaticResource LinkButton}" Content="Restore backup…" Command="{Binding ChooseRestoreCommand}" Margin="0,0,14,6" />
                            <Button Style="{StaticResource LinkButton}" Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="0,0,0,6" />
                        </WrapPanel>
                        <TextBlock Text="{Binding DataStatus}" Style="{StaticResource LabelText}" TextWrapping="Wrap"
                                   Visibility="{Binding DataStatus, Converter={StaticResource NullToCollapsed}}" />
                        <StackPanel Visibility="{Binding ConfirmingRestore, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                            <TextBlock Text="{Binding RestoreDescription}" Style="{StaticResource LabelText}" TextWrapping="Wrap" />
                            <TextBlock Text="Replace current data and restart?" FontSize="12" Margin="0,6,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource DangerLinkButton}" Content="Restore" Command="{Binding ConfirmRestoreCommand}" />
                                <TextBlock Text="·" Foreground="{DynamicResource PastBrush}" Margin="8,0" VerticalAlignment="Center" />
                                <Button Style="{StaticResource LinkButton}" Content="Cancel" Command="{Binding CancelRestoreCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Diagnostics" Style="{StaticResource SearchHeading}" />
                <Border Style="{StaticResource SearchRow}" Tag="Health status errors logs copy diagnostics">
                    <StackPanel>
                        <TextBlock Text="{Binding Health.Status, TargetNullValue=No issues reported}" TextWrapping="Wrap" Style="{StaticResource LabelText}" AutomationProperties.LiveSetting="Polite" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button Style="{StaticResource LinkButton}" Content="Open logs" Command="{Binding OpenLogsCommand}" Margin="0,0,14,0" />
                            <Button Content="Copy diagnostics" Command="{Binding CopyDiagnosticsCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Health.DiagnosticsBusy}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </WrapPanel>
                        <TextBlock Text="{Binding Health.DiagnosticStatus}" Style="{StaticResource LabelText}" Margin="0,4,0,0"
                                   Visibility="{Binding Health.DiagnosticStatus, Converter={StaticResource NullToCollapsed}}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
                <TextBlock Text="About" Style="{StaticResource SearchHeading}" />
                <Border Style="{StaticResource SearchRow}" Tag="BDO Timers © 2026 feluminais · Free software under GPL-3.0, with no warranty. Not affiliated with Pearl Abyss. Game artwork © Pearl Abyss. · Check for updates View release Source code Licenses version updates release licenses GPL source code">
                    <StackPanel>
                        <TextBlock FontSize="12">
                            <Run Text="BDO Timers" /> <Run Text="{Binding Version, Mode=OneWay}" Foreground="{DynamicResource SubtleBrush}" />
                        </TextBlock>
                        <TextBlock Text="© 2026 feluminais · Free software under GPL-3.0, with no warranty." Style="{StaticResource LabelText}" Margin="0,2,0,0" />
                        <TextBlock Text="Not affiliated with Pearl Abyss. Game artwork © Pearl Abyss." Style="{StaticResource LabelText}" Margin="0,2,0,6" />
                        <WrapPanel Margin="0,0,0,6">
                            <Button Style="{StaticResource LinkButton}" Content="Check for updates" Command="{Binding CheckForUpdatesCommand}" Margin="0,0,14,0" />
                            <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,8,0"
                                       AutomationProperties.LiveSetting="Polite" Visibility="{Binding UpdateStatus, Converter={StaticResource NullToCollapsed}}" />
                            <TextBlock Text="{Binding AvailableVersion}" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"
                                       Visibility="{Binding AvailableVersion, Converter={StaticResource NullToCollapsed}}" />
                            <Button Style="{StaticResource LinkButton}" Content="View release" Command="{Binding OpenReleaseCommand}"
                                    Visibility="{Binding AvailableVersion, Converter={StaticResource NullToCollapsed}}" />
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource LinkButton}" Content="Source code" Command="{Binding OpenSourceCommand}" />
                            <TextBlock Text="·" Foreground="{DynamicResource PastBrush}" Margin="8,0" VerticalAlignment="Center" />
                            <Button Style="{StaticResource LinkButton}" Content="Licenses" Command="{Binding OpenLicensesCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
