<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:BdoTimers.App.Controls"
                    xmlns:overlay="clr-namespace:BdoTimers.App.Overlay">
    <!-- The overlay's List, Card and Bar layouts -->

    <Style x:Key="SampleDim" TargetType="FrameworkElement">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSample}" Value="True">
                <Setter Property="Opacity" Value="0.4" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SpawnName" TargetType="TextBlock" BasedOn="{StaticResource DisplayText}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Skipped}" Value="True">
                <Setter Property="TextDecorations" Value="Strikethrough" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ClockIcon" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
        <Setter Property="Margin" Value="10,0,4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ClockTime" TargetType="TextBlock" BasedOn="{StaticResource ClockText}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Local, server and in-game time on one line in a faint box: a monitor, a globe, and a sun or by night a moon -->
    <Style x:Key="OverlayClocks" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Visibility" Value="{Binding HasClocks, Converter={StaticResource BoolToVisibility}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource HairlineStrongBrush}"
                            BorderThickness="1" Padding="6,1">
                        <!-- Each icon's left margin spaces it from the clock before; this takes back the first one's -->
                        <StackPanel Orientation="Horizontal" Margin="-10,0,0,0">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding Clock, Converter={StaticResource NullToCollapsed}}">
                                <TextBlock Style="{StaticResource ClockIcon}" Text="&#xE7F4;" />
                                <TextBlock Style="{StaticResource ClockTime}" Text="{Binding Clock}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding ServerClock, Converter={StaticResource NullToCollapsed}}">
                                <TextBlock Style="{StaticResource ClockIcon}" Text="&#xE909;" />
                                <TextBlock Style="{StaticResource ClockTime}" Text="{Binding ServerClock}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding GameClock, Converter={StaticResource NullToCollapsed}}">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ClockIcon}">
                                            <Setter Property="Text" Value="&#xE706;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNight}" Value="True">
                                                    <Setter Property="Text" Value="&#xE708;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource ClockTime}" Text="{Binding GameClock}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PopUpList" TargetType="ItemsControl">
        <Setter Property="ItemsSource" Value="{Binding PopUps}" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!-- Rows -->
    <DataTemplate x:Key="PreviousRow" DataType="{x:Type overlay:OverlaySpawn}">
        <DockPanel Style="{StaticResource SampleDim}" Margin="0,2">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Style="{StaticResource ClockText}" FontSize="12"
                       Foreground="{DynamicResource SubtleBrush}" Margin="14,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="&#x2039;" Foreground="{DynamicResource AccentSoftBrush}" FontSize="13" Width="12" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Names}" Style="{StaticResource SpawnName}" FontSize="12" Foreground="{DynamicResource SubtleBrush}" />
        </DockPanel>
    </DataTemplate>
    <DataTemplate x:Key="NextRow" DataType="{x:Type overlay:OverlaySpawn}">
        <DockPanel Style="{StaticResource SampleDim}" Margin="0,2">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Style="{StaticResource ClockText}" FontSize="16"
                       Foreground="{DynamicResource AccentTextBrush}" Margin="14,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="&#x203A;" Foreground="{DynamicResource AccentBrush}" FontSize="17" Width="12" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Names}" Style="{StaticResource SpawnName}" FontSize="14" />
        </DockPanel>
    </DataTemplate>
    <DataTemplate x:Key="LineRow" DataType="{x:Type overlay:OverlayLine}">
        <DockPanel Style="{StaticResource SampleDim}" Margin="12,2,0,2">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Style="{StaticResource ClockText}" FontSize="13"
                       Foreground="{DynamicResource AccentTextBrush}" Margin="14,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Name}" Style="{StaticResource DisplayText}" FontSize="13" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </DataTemplate>
    <DataTemplate x:Key="ChipLine" DataType="{x:Type overlay:OverlayLine}">
        <Border Style="{StaticResource SampleDim}" BorderBrush="{DynamicResource HairlineStrongBrush}" BorderThickness="1"
                Padding="6,1" Margin="0,0,6,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" Style="{StaticResource DisplayText}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Time}" Style="{StaticResource ClockText}" FontSize="12" Foreground="{DynamicResource AccentTextBrush}"
                           Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </DataTemplate>
    <DataTemplate x:Key="CardBanner" DataType="{x:Type overlay:OverlaySpawn}">
        <Grid Style="{StaticResource SampleDim}" Height="72">
            <controls:ArtImage Sources="{Binding Images}" />
            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,10,5">
                <TextBlock Text="{Binding Names}" Style="{StaticResource SpawnName}" FontSize="15" HorizontalAlignment="Right" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="&#x203A;" Foreground="{DynamicResource AccentBrush}" FontSize="18" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Time}" Style="{StaticResource ClockText}" FontSize="17" Foreground="{DynamicResource AccentTextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="BarPrevious" DataType="{x:Type overlay:OverlaySpawn}">
        <StackPanel Style="{StaticResource SampleDim}" Orientation="Horizontal" Margin="0,0,14,0">
            <TextBlock Text="&#x2039;" Foreground="{DynamicResource AccentSoftBrush}" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Names}" Style="{StaticResource SpawnName}" FontSize="12" Foreground="{DynamicResource SubtleBrush}" />
            <TextBlock Text="{Binding Time}" Style="{StaticResource ClockText}" FontSize="12" Foreground="{DynamicResource SubtleBrush}"
                       Margin="6,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="BarNext" DataType="{x:Type overlay:OverlaySpawn}">
        <StackPanel Style="{StaticResource SampleDim}" Orientation="Horizontal" Margin="0,0,14,0">
            <TextBlock Text="&#x203A;" Foreground="{DynamicResource AccentBrush}" FontSize="16" Margin="0,0,4,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Names}" Style="{StaticResource SpawnName}" FontSize="14" />
            <TextBlock Text="{Binding Time}" Style="{StaticResource ClockText}" FontSize="15" Foreground="{DynamicResource AccentTextBrush}"
                       Margin="6,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="BarLine" DataType="{x:Type overlay:OverlayLine}">
        <StackPanel Style="{StaticResource SampleDim}" Orientation="Horizontal" Margin="0,0,14,0">
            <TextBlock Text="{Binding Name}" Style="{StaticResource DisplayText}" FontSize="13" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Time}" Style="{StaticResource ClockText}" FontSize="13" Foreground="{DynamicResource AccentTextBrush}"
                       Margin="6,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <!-- Layouts. Sections are ContentControls: a ContentPresenter takes its Content as DataContext, so a Visibility
         binding on it would miss the view model and an empty section would keep its space. -->
    <DataTemplate x:Key="ListLayout" DataType="{x:Type overlay:OverlayViewModel}">
        <StackPanel Margin="12,8" MinWidth="200">
            <ContentControl Style="{StaticResource OverlayClocks}" Margin="0,0,0,4" />
            <ContentControl Content="{Binding Previous}" ContentTemplate="{StaticResource PreviousRow}"
                            Focusable="False" Visibility="{Binding Previous, Converter={StaticResource NullToCollapsed}}" />
            <ContentControl Content="{Binding Next}" ContentTemplate="{StaticResource NextRow}"
                            Focusable="False" Visibility="{Binding Next, Converter={StaticResource NullToCollapsed}}" />
            <ItemsControl Style="{StaticResource PopUpList}" ItemTemplate="{StaticResource LineRow}" />
            <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,5"
                    Visibility="{Binding ShowDivider, Converter={StaticResource BoolToVisibility}}" />
            <ContentControl Content="{Binding Farm}" ContentTemplate="{StaticResource LineRow}"
                            Focusable="False" Visibility="{Binding Farm, Converter={StaticResource NullToCollapsed}}" />
            <ContentControl Content="{Binding Fishing}" ContentTemplate="{StaticResource LineRow}"
                            Focusable="False" Visibility="{Binding Fishing, Converter={StaticResource NullToCollapsed}}" />
            <ItemsControl ItemsSource="{Binding HorseRegistrations}" ItemTemplate="{StaticResource LineRow}" Focusable="False" />
            <TextBlock Text="{Binding MoreHorseRegistrations}" Style="{StaticResource LabelText}" Margin="12,2,0,0"
                       Visibility="{Binding MoreHorseRegistrations, Converter={StaticResource NullToCollapsed}}" />
            <TextBlock Text="Custom timers" Style="{StaticResource LabelText}" Margin="12,6,0,2"
                       Visibility="{Binding HasCustomTimers, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding CustomTimers}" ItemTemplate="{StaticResource LineRow}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="CardLayout" DataType="{x:Type overlay:OverlayViewModel}">
        <StackPanel Width="250">
            <Grid>
                <ContentControl Content="{Binding Next}" ContentTemplate="{StaticResource CardBanner}"
                                Focusable="False" Visibility="{Binding Next, Converter={StaticResource NullToCollapsed}}" />
                <ContentControl Style="{StaticResource OverlayClocks}" Background="#CC0B0B0C" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Margin="0,6,6,0" />
            </Grid>
            <StackPanel Margin="10,4,10,8">
                <ContentControl Content="{Binding Previous}" ContentTemplate="{StaticResource PreviousRow}"
                                Focusable="False" Visibility="{Binding Previous, Converter={StaticResource NullToCollapsed}}" />
                <ItemsControl Style="{StaticResource PopUpList}" ItemTemplate="{StaticResource LineRow}" />
                <WrapPanel Margin="0,4,0,0">
                    <ContentControl Content="{Binding Farm}" ContentTemplate="{StaticResource ChipLine}"
                                    Focusable="False" Visibility="{Binding Farm, Converter={StaticResource NullToCollapsed}}" />
                    <ContentControl Content="{Binding Fishing}" ContentTemplate="{StaticResource ChipLine}"
                                    Focusable="False" Visibility="{Binding Fishing, Converter={StaticResource NullToCollapsed}}" />
                </WrapPanel>
                <ItemsControl ItemsSource="{Binding HorseRegistrations}" ItemTemplate="{StaticResource LineRow}" Focusable="False" />
                <TextBlock Text="{Binding MoreHorseRegistrations}" Style="{StaticResource LabelText}" Margin="12,2,0,0"
                           Visibility="{Binding MoreHorseRegistrations, Converter={StaticResource NullToCollapsed}}" />
                <TextBlock Text="Custom timers" Style="{StaticResource LabelText}" Margin="12,6,0,2"
                           Visibility="{Binding HasCustomTimers, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding CustomTimers}" ItemTemplate="{StaticResource LineRow}" Focusable="False" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="BarLayout" DataType="{x:Type overlay:OverlayViewModel}">
        <StackPanel Orientation="Horizontal" Margin="8,5">
            <ContentControl Style="{StaticResource OverlayClocks}" Margin="0,0,12,0" VerticalAlignment="Center" />
            <ContentControl Content="{Binding Previous}" ContentTemplate="{StaticResource BarPrevious}" VerticalAlignment="Center"
                            Focusable="False" Visibility="{Binding Previous, Converter={StaticResource NullToCollapsed}}" />
            <ContentControl Content="{Binding Next}" ContentTemplate="{StaticResource BarNext}" VerticalAlignment="Center"
                            Focusable="False" Visibility="{Binding Next, Converter={StaticResource NullToCollapsed}}" />
            <ItemsControl Style="{StaticResource PopUpList}" ItemTemplate="{StaticResource BarLine}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <ContentControl Content="{Binding Farm}" ContentTemplate="{StaticResource BarLine}" VerticalAlignment="Center"
                            Focusable="False" Visibility="{Binding Farm, Converter={StaticResource NullToCollapsed}}" />
            <ContentControl Content="{Binding Fishing}" ContentTemplate="{StaticResource BarLine}" VerticalAlignment="Center"
                            Focusable="False" Visibility="{Binding Fishing, Converter={StaticResource NullToCollapsed}}" />
            <ItemsControl ItemsSource="{Binding HorseRegistrations}" ItemTemplate="{StaticResource BarLine}" VerticalAlignment="Center" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Text="{Binding MoreHorseRegistrations}" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="4,0,0,0"
                       Visibility="{Binding MoreHorseRegistrations, Converter={StaticResource NullToCollapsed}}" />
            <TextBlock Text="Custom timers" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,10,0"
                       Visibility="{Binding HasCustomTimers, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding CustomTimers}" ItemTemplate="{StaticResource BarLine}" VerticalAlignment="Center" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
