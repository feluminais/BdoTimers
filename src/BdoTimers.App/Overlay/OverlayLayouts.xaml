<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:BdoTimers.App.Controls"
                    xmlns:overlay="clr-namespace:BdoTimers.App.Overlay">
    <!-- The overlay's List, Card and Bar layouts -->

    <Style x:Key="SampleDim" TargetType="FrameworkElement">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSample}" Value="True">
                <Setter Property="Opacity" Value="0.4" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SpawnName" TargetType="TextBlock" BasedOn="{StaticResource DisplayText}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Skipped}" Value="True">
                <Setter Property="TextDecorations" Value="Strikethrough" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="OverlayClock" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource AccentSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Visibility" Value="{Binding Clock, Converter={StaticResource NullToCollapsed}}" />
    </Style>
    <Style x:Key="OverlayClockText" TargetType="TextBlock" BasedOn="{StaticResource ClockText}">
        <Setter Property="Text" Value="{Binding Clock}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
    </Style>
    <Style x:Key="PopUpList" TargetType="ItemsControl">
        <Setter Property="ItemsSource" Value="{Binding PopUps}" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!-- Rows -->
    <DataTemplate x:Key="PreviousRow" DataType="{x:Type overlay:OverlaySpawn}">
        <DockPanel Style="{StaticResource SampleDim}" Margin="0,2">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Style="{StaticResource ClockText}" FontSize="12"
                       Foreground="{StaticResource SubtleBrush}" Margin="14,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="&#x2039;" Foreground="{StaticResource AccentSoftBrush}" FontSize="13" Width="12" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Names}" Style="{StaticResource SpawnName}" FontSize="12" Foreground="{StaticResource SubtleBrush}" />
        </DockPanel>
    </DataTemplate>
    <DataTemplate x:Key="NextRow" DataType="{x:Type overlay:OverlaySpawn}">
        <DockPanel Style="{StaticResource SampleDim}" Margin="0,2">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Style="{StaticResource ClockText}" FontSize="16"
                       Foreground="{StaticResource AccentTextBrush}" Margin="14,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="&#x203A;" Foreground="{StaticResource AccentBrush}" FontSize="17" Width="12" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Names}" Style="{StaticResource SpawnName}" FontSize="14" />
        </DockPanel>
    </DataTemplate>
    <DataTemplate x:Key="LineRow" DataType="{x:Type overlay:OverlayLine}">
        <DockPanel Style="{StaticResource SampleDim}" Margin="12,2,0,2">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Style="{StaticResource ClockText}" FontSize="13"
                       Foreground="{StaticResource AccentTextBrush}" Margin="14,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Name}" Style="{StaticResource DisplayText}" FontSize="13" VerticalAlignment="Center" />
        </DockPanel>
    </DataTemplate>
    <DataTemplate x:Key="ChipLine" DataType="{x:Type overlay:OverlayLine}">
        <Border Style="{StaticResource SampleDim}" BorderBrush="{StaticResource HairlineStrongBrush}" BorderThickness="1"
                Padding="6,1" Margin="0,0,6,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" Style="{StaticResource DisplayText}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Time}" Style="{StaticResource ClockText}" FontSize="12" Foreground="{StaticResource AccentTextBrush}"
                           Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </DataTemplate>
    <DataTemplate x:Key="CardBanner" DataType="{x:Type overlay:OverlaySpawn}">
        <Grid Style="{StaticResource SampleDim}" Height="72">
            <controls:ArtImage Sources="{Binding Images}" />
            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,10,5">
                <TextBlock Text="{Binding Names}" Style="{StaticResource SpawnName}" FontSize="15" HorizontalAlignment="Right" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="&#x203A;" Foreground="{StaticResource AccentBrush}" FontSize="18" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Time}" Style="{StaticResource ClockText}" FontSize="17" Foreground="{StaticResource AccentTextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="BarPrevious" DataType="{x:Type overlay:OverlaySpawn}">
        <StackPanel Style="{StaticResource SampleDim}" Orientation="Horizontal" Margin="0,0,14,0">
            <TextBlock Text="&#x2039;" Foreground="{StaticResource AccentSoftBrush}" FontSize="13" Margin="0,0,4,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Names}" Style="{StaticResource SpawnName}" FontSize="12" Foreground="{StaticResource SubtleBrush}" />
            <TextBlock Text="{Binding Time}" Style="{StaticResource ClockText}" FontSize="12" Foreground="{StaticResource SubtleBrush}"
                       Margin="6,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="BarNext" DataType="{x:Type overlay:OverlaySpawn}">
        <StackPanel Style="{StaticResource SampleDim}" Orientation="Horizontal" Margin="0,0,14,0">
            <TextBlock Text="&#x203A;" Foreground="{StaticResource AccentBrush}" FontSize="16" Margin="0,0,4,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Names}" Style="{StaticResource SpawnName}" FontSize="14" />
            <TextBlock Text="{Binding Time}" Style="{StaticResource ClockText}" FontSize="15" Foreground="{StaticResource AccentTextBrush}"
                       Margin="6,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="BarLine" DataType="{x:Type overlay:OverlayLine}">
        <StackPanel Style="{StaticResource SampleDim}" Orientation="Horizontal" Margin="0,0,14,0">
            <TextBlock Text="{Binding Name}" Style="{StaticResource DisplayText}" FontSize="13" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Time}" Style="{StaticResource ClockText}" FontSize="13" Foreground="{StaticResource AccentTextBrush}"
                       Margin="6,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <!-- Layouts -->
    <DataTemplate x:Key="ListLayout" DataType="{x:Type overlay:OverlayViewModel}">
        <StackPanel Margin="12,8" MinWidth="200">
            <Border Style="{StaticResource OverlayClock}" Margin="0,0,0,4">
                <TextBlock Style="{StaticResource OverlayClockText}" />
            </Border>
            <ContentPresenter Content="{Binding Previous}" ContentTemplate="{StaticResource PreviousRow}"
                              Visibility="{Binding Previous, Converter={StaticResource NullToCollapsed}}" />
            <ContentPresenter Content="{Binding Next}" ContentTemplate="{StaticResource NextRow}"
                              Visibility="{Binding Next, Converter={StaticResource NullToCollapsed}}" />
            <ItemsControl Style="{StaticResource PopUpList}" ItemTemplate="{StaticResource LineRow}" />
            <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,5"
                    Visibility="{Binding ShowDivider, Converter={StaticResource BoolToVisibility}}" />
            <ContentPresenter Content="{Binding Farm}" ContentTemplate="{StaticResource LineRow}"
                              Visibility="{Binding Farm, Converter={StaticResource NullToCollapsed}}" />
            <ContentPresenter Content="{Binding Fishing}" ContentTemplate="{StaticResource LineRow}"
                              Visibility="{Binding Fishing, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="CardLayout" DataType="{x:Type overlay:OverlayViewModel}">
        <StackPanel Width="250">
            <Grid>
                <ContentPresenter Content="{Binding Next}" ContentTemplate="{StaticResource CardBanner}"
                                  Visibility="{Binding Next, Converter={StaticResource NullToCollapsed}}" />
                <Border Style="{StaticResource OverlayClock}" Background="#CC0B0B0C" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,6,6,0">
                    <TextBlock Style="{StaticResource OverlayClockText}" />
                </Border>
            </Grid>
            <StackPanel Margin="10,4,10,8">
                <ContentPresenter Content="{Binding Previous}" ContentTemplate="{StaticResource PreviousRow}"
                                  Visibility="{Binding Previous, Converter={StaticResource NullToCollapsed}}" />
                <ItemsControl Style="{StaticResource PopUpList}" ItemTemplate="{StaticResource LineRow}" />
                <WrapPanel Margin="0,4,0,0">
                    <ContentPresenter Content="{Binding Farm}" ContentTemplate="{StaticResource ChipLine}"
                                      Visibility="{Binding Farm, Converter={StaticResource NullToCollapsed}}" />
                    <ContentPresenter Content="{Binding Fishing}" ContentTemplate="{StaticResource ChipLine}"
                                      Visibility="{Binding Fishing, Converter={StaticResource NullToCollapsed}}" />
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="BarLayout" DataType="{x:Type overlay:OverlayViewModel}">
        <StackPanel Orientation="Horizontal" Margin="8,5">
            <Border Style="{StaticResource OverlayClock}" Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource OverlayClockText}" />
            </Border>
            <ContentPresenter Content="{Binding Previous}" ContentTemplate="{StaticResource BarPrevious}" VerticalAlignment="Center"
                              Visibility="{Binding Previous, Converter={StaticResource NullToCollapsed}}" />
            <ContentPresenter Content="{Binding Next}" ContentTemplate="{StaticResource BarNext}" VerticalAlignment="Center"
                              Visibility="{Binding Next, Converter={StaticResource NullToCollapsed}}" />
            <ItemsControl Style="{StaticResource PopUpList}" ItemTemplate="{StaticResource BarLine}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <ContentPresenter Content="{Binding Farm}" ContentTemplate="{StaticResource BarLine}" VerticalAlignment="Center"
                              Visibility="{Binding Farm, Converter={StaticResource NullToCollapsed}}" />
            <ContentPresenter Content="{Binding Fishing}" ContentTemplate="{StaticResource BarLine}" VerticalAlignment="Center"
                              Visibility="{Binding Fishing, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
