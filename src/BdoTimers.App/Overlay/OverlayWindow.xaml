<Window x:Class="BdoTimers.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BDO Timers Overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual" UseLayoutRounding="True"
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <ResourceDictionary Source="OverlayLayouts.xaml" />
    </Window.Resources>
    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
        </Grid.LayoutTransform>
        <!-- Background colour or picture; no outline, so nothing on it draws the eye in game -->
        <Border Background="{Binding Background}" Opacity="{Binding BackgroundOpacity}" />
        <ContentControl Content="{Binding}" Opacity="{Binding TextOpacity}" Focusable="False">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate" Value="{StaticResource ListLayout}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Layout}" Value="Card">
                            <Setter Property="ContentTemplate" Value="{StaticResource CardLayout}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Layout}" Value="Bar">
                            <Setter Property="ContentTemplate" Value="{StaticResource BarLayout}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
        <!-- Preview: a near-invisible fill keeps the overlay draggable even with its outline off -->
        <Border BorderBrush="{DynamicResource HairlineStrongBrush}" BorderThickness="{Binding OutlineThickness}" Background="#01000000"
                Visibility="{Binding IsPreview, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</Window>
