<Window x:Class="BdoTimers.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual">
    <Border x:Name="Frame" Background="#D90B0B0C" Padding="12,6" BorderThickness="1" BorderBrush="{StaticResource AccentSoftBrush}">
        <ItemsControl x:Name="Items">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource DisplayText}" Foreground="{StaticResource TextBrush}"
                                   FontSize="14" MinWidth="140" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Countdown}" Style="{StaticResource ClockText}" Foreground="{StaticResource AccentTextBrush}"
                                   FontSize="16" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
