<Application x:Class="BdoTimers.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BdoTimers.App.Controls"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <controls:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <controls:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <controls:WidthToColumnsConverter x:Key="WidthToColumns" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
