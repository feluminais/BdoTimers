<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:BdoTimers.App.Controls"
                    xmlns:views="clr-namespace:BdoTimers.App.Views">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <controls:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <controls:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <controls:AtLeastConverter x:Key="AtLeast" />
    <controls:WidthToColumnsConverter x:Key="WidthToColumns" />
    <!-- A panel's ✕ and Done both close it -->
    <Style x:Key="PanelCloseButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Content" Value="&#xE8BB;" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="ToolTip" Value="Close" />
        <Setter Property="Command" Value="{x:Static views:PanelCommands.Close}" />
    </Style>
    <Style x:Key="PanelDoneButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Content" Value="Done" />
        <Setter Property="DockPanel.Dock" Value="Right" />
        <Setter Property="Command" Value="{x:Static views:PanelCommands.Finish}" />
    </Style>
    <!-- A panel's header picture: the whole area is clickable, and a labelled badge in its corner says so -->
    <Style x:Key="PictureButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <ContentPresenter />
                        <Border x:Name="Badge" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,10" Padding="6,4"
                                Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource HairlineStrongBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Icon" Style="{StaticResource IconText}" Text="&#xEB9F;" FontSize="12"
                                           Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="Label" Text="Change picture" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SubtleBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- To-do rows: used by the To-do screen and by Today's daily tasks -->
    <Style x:Key="TodoOpenButton" TargetType="Button" BasedOn="{StaticResource NameButton}" />
    <Style x:Key="TodoCheck" TargetType="CheckBox">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Hit" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" BorderBrush="{DynamicResource SubtleBrush}"
                                BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="Mark" FontSize="10" Text="" FontWeight="Bold"
                                       Foreground="{DynamicResource OnBronzeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GoodBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Text" Value="✓" />
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource GoodBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GoodBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Mark" Property="Text" Value="−" />
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource GoodBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GoodBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- One of Garmoth's weekly kills: a ring with its number, filled once it is marked -->
    <Style x:Key="KillButton" TargetType="Button" BasedOn="{StaticResource BareButton}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="controls:Ui.CornerRadius" Value="17" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush" Value="{DynamicResource ForestLineStrongBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource GoodBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsDone}" Value="True">
                <Setter Property="Background" Value="{DynamicResource GoodBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GoodBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OnBronzeBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TodoRowText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsStruck}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource PastBrush}" />
                <Setter Property="TextDecorations" Value="Strikethrough" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- A list's progress: a green line over a hairline -->
    <Style x:Key="TodoProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="2" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{DynamicResource ForestLineStrongBrush}" />
                        <Border x:Name="PART_Indicator" Background="{DynamicResource GoodBrush}" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Start / Pause takes the Timers blue while the timer runs -->
    <Style x:Key="TimerPlayButton" TargetType="Button" BasedOn="{StaticResource RoundButton}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource TimersAccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TimersAccentBrush}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsRunning}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource IndigoHoverFillBrush}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
