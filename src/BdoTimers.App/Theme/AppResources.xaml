<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:BdoTimers.App.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <controls:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <controls:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <controls:AtLeastConverter x:Key="AtLeast" />
    <controls:WidthToColumnsConverter x:Key="WidthToColumns" />
    <!-- A panel's ✕ and Done both close it -->
    <Style x:Key="PanelCloseButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Content" Value="&#xE8BB;" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="ToolTip" Value="Close" />
        <Setter Property="Command" Value="{Binding DataContext.ClosePanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Style>
    <Style x:Key="PanelDoneButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
        <Setter Property="Content" Value="Done" />
        <Setter Property="DockPanel.Dock" Value="Right" />
        <Setter Property="Command" Value="{Binding DataContext.FinishPanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Style>
    <!-- A panel's header picture: the whole area is clickable, and a labelled badge in its corner says so -->
    <Style x:Key="PictureButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <ContentPresenter />
                        <Border x:Name="Badge" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,10" Padding="6,4"
                                Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource HairlineStrongBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Icon" Style="{StaticResource IconText}" Text="&#xEB9F;" FontSize="12"
                                           Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="Label" Text="Change picture" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SubtleBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
