<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BdoTimers.Core\BdoTimers.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
    <PackageReference Include="NAudio" Version="3.1.0" />
    <!-- NAudio.dll (AudioFileReader) uses Core, WinMM (which references Midi) and Wasapi. The package also pulls in its
         ASIO, DMO and WinForms parts, and with WinForms the whole Windows Forms runtime. -->
    <PrunePackageReference Include="NAudio.Asio;NAudio.Dmo;NAudio.WinForms" Version="3.1.0" />
    <!-- Offline neural speech. Only the Windows runtime package; the wrapper DLL is kept in lib/ (see its README). -->
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="1.13.8" />
    <Reference Include="sherpa-onnx" HintPath="..\..\lib\sherpa-onnx\sherpa-onnx.dll" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Bosses\*.jpg;Assets\Timers\*.jpg" />
    <!-- Windows shows it on notifications; it reads the picture from a file. -->
    <None Update="Assets\app.png" Link="app.png" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\Sounds\*.wav" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Theme\Fonts\*.ttf" />
    <None Include="..\..\LICENSE" Link="licenses\GPL-3.0.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="licenses\THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- The SIL Open Font License asks for the licence to travel with the font. -->
    <None Include="Theme\Fonts\OFL.txt" Link="licenses\Cinzel-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Sounds\SOURCES.txt" Link="licenses\Sounds.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Kokoro voice model, fetched by scripts/get-voice.ps1; without it alerts aren't spoken. -->
    <None Update="Voice\kokoro\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Data\ lives beside the exe, so the dev build's folder stays bin\Debug across runtime upgrades. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AssemblyName>BdoTimers</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RootNamespace>BdoTimers.App</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
