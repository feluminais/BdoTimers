<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BdoTimers.Core\BdoTimers.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
    <!-- Foundation alone provides app notifications; the full Microsoft.WindowsAppSDK bundle adds WinUI, AI, ML and ~170 unused files. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <!-- Foundation asks for 2.1.8, which isn't published; pinning the available version avoids NU1603 on every restore. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="NAudio" Version="3.1.0" />
    <PackageReference Include="System.Speech" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Windows App SDK adds images as Content by default, which makes WPF look for loose files
         instead of the embedded resource. -->
    <Content Remove="Assets\Bosses\*.jpg" />
    <Resource Include="Assets\Bosses\*.jpg" />
    <Resource Include="Theme\Fonts\*.ttf" />
    <!-- The SIL Open Font License asks for the licence to travel with the font. -->
    <None Include="Theme\Fonts\OFL.txt" Link="licenses\Cinzel-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AssemblyName>BdoTimers</AssemblyName>
    <RootNamespace>BdoTimers.App</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Self-contained Windows App SDK output omits Microsoft.WindowsAppRuntime.Insights.Resource.dll, and
    AppNotificationManager.Register() then fails with 0x8007007E. The DLL ships inside the runtime MSIX,
    so it is extracted from there. The package is referenced only for its files (ExcludeAssets="all").
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <Target Name="AddWindowsAppRuntimeInsightsResource" BeforeTargets="AssignTargetPaths">
    <PropertyGroup>
      <InsightsDir>$(IntermediateOutputPath)winappruntime\</InsightsDir>
    </PropertyGroup>
    <Unzip SourceFiles="$(PkgMicrosoft_WindowsAppSDK_Runtime)\tools\MSIX\win10-x64\Microsoft.WindowsAppRuntime.2.msix"
           DestinationFolder="$(InsightsDir)" Include="Microsoft.WindowsAppRuntime.Insights.Resource.dll"
           SkipUnchangedFiles="true" />
    <ItemGroup>
      <None Include="$(InsightsDir)Microsoft.WindowsAppRuntime.Insights.Resource.dll"
            Link="Microsoft.WindowsAppRuntime.Insights.Resource.dll"
            CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
