<UserControl x:Class="BdoTimers.App.Controls.ArtImage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" ClipToBounds="True" IsHitTestVisible="False">
    <ItemsControl ItemsSource="{Binding Sources, ElementName=Root}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Columns="1" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border ClipToBounds="True">
                    <Image Source="{Binding}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
        <!-- The picture melts into the black to its right instead of ending at a hard edge. -->
        <ItemsControl.OpacityMask>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FF000000" Offset="0" />
                <GradientStop Color="#FF000000" Offset="0.3" />
                <GradientStop Color="#80000000" Offset="0.65" />
                <GradientStop Color="#00000000" Offset="1" />
            </LinearGradientBrush>
        </ItemsControl.OpacityMask>
    </ItemsControl>
</UserControl>
