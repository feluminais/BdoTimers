<UserControl x:Class="BdoTimers.App.Controls.CycleSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource IconButton}" Content="&#xE76B;" FontSize="9" Width="22" Height="22"
                Click="Previous_Click" ToolTip="Previous" />
        <!-- Fixed width so the arrows stay put; long values are trimmed and shown whole in the tooltip -->
        <TextBlock Text="{Binding SelectedItem, ElementName=Root}" Width="{Binding ValueWidth, ElementName=Root}"
                   ToolTip="{Binding SelectedItem, ElementName=Root}" TextTrimming="CharacterEllipsis"
                   TextAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextBrush}" />
        <Button Style="{StaticResource IconButton}" Content="&#xE76C;" FontSize="9" Width="22" Height="22"
                Click="Next_Click" ToolTip="Next" />
    </StackPanel>
</UserControl>
