<UserControl x:Class="BdoTimers.App.Controls.DateInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BdoTimers.App.Controls"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             x:Name="Root" PreviewKeyDown="Root_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DateInputTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="DateBox" VerticalAlignment="Center"
                 Text="{Binding Text, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 controls:Ui.HasError="{Binding HasError, ElementName=Root}"
                 ToolTip="{Binding ToolTip, ElementName=Root}"
                 AutomationProperties.Name="{Binding (AutomationProperties.Name), ElementName=Root}" />
        <Button Grid.Column="1" x:Name="CalendarButton" Style="{StaticResource IconButton}" Content="&#xE787;"
                Width="30" Height="30" ToolTip="Choose date" Click="CalendarButton_Click"
                AutomationProperties.Name="{Binding (AutomationProperties.Name), ElementName=Root, StringFormat=Choose {0}}" />
        <Popup x:Name="CalendarPopup" Grid.ColumnSpan="2" PlacementTarget="{Binding ElementName=DateBox}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Opened="CalendarPopup_Opened">
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource HairlineStrongBrush}"
                    BorderThickness="1" Padding="6" KeyboardNavigation.TabNavigation="Cycle" LayoutTransform="{DynamicResource UiScaleTransform}"
                    PreviewKeyDown="Root_PreviewKeyDown">
                <StackPanel>
                    <Calendar x:Name="Picker" SelectionMode="SingleDate" SelectedDatesChanged="Picker_SelectedDatesChanged"
                              Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
                              CalendarItemStyle="{StaticResource DateCalendarItem}" CalendarDayButtonStyle="{StaticResource DateCalendarDay}"
                              CalendarButtonStyle="{StaticResource DateCalendarMonth}"
                              BorderThickness="0" AutomationProperties.Name="{Binding (AutomationProperties.Name), ElementName=Root}"
                              PreviewKeyDown="Picker_PreviewKeyDown" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="Today" Click="Today_Click" Margin="0,0,8,0" />
                        <Button Style="{StaticResource GhostButton}" Content="Tomorrow" Click="Tomorrow_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
