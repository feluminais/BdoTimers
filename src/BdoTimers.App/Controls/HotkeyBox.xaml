<UserControl x:Class="BdoTimers.App.Controls.HotkeyBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <StackPanel Width="130">
        <Border x:Name="Field" BorderThickness="1" BorderBrush="{StaticResource HairlineStrongBrush}"
                Background="{StaticResource HoverFillBrush}" Padding="5,1" Cursor="Hand"
                ToolTip="Click to record a hotkey" MouseLeftButtonDown="Field_MouseLeftButtonDown">
            <DockPanel>
                <Button x:Name="ClearButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="8"
                        Width="20" Height="20" ToolTip="Clear" Click="Clear_Click" />
                <TextBlock x:Name="KeyText" FontSize="12" Margin="2,3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
        <TextBlock x:Name="Message" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
