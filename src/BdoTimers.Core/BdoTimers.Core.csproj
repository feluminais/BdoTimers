<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- One timetable per region (Seed/BossRegions.cs). WithCulture="false" keeps "eu" (Basque) from moving a file
         into a satellite assembly. -->
    <EmbeddedResource Include="Data\bosses.*.json" LogicalName="BdoTimers.Core.Data.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

</Project>
