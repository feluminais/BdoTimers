<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The bundle's own setup window (WiX v5 out-of-process bootstrapper application). .NET Framework 4.8 ships with
    Windows 10 and 11, so the setup needs no runtime of its own. The app's theme, art control, font, icon and two
    boss pictures are linked in so both windows share one look.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>SetupUi</AssemblyName>
    <RootNamespace>BdoTimers.SetupUi</RootNamespace>
    <!-- Selects the matching native mbanative.dll from the WiX package. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>..\..\src\BdoTimers.App\Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="WixToolset.BootstrapperApplicationApi" Version="5.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="..\..\src\BdoTimers.App\Theme\Theme.xaml" Link="Theme\Theme.xaml" />
    <Page Include="..\..\src\BdoTimers.App\Controls\ArtImage.xaml" Link="Controls\ArtImage.xaml" />
    <Compile Include="..\..\src\BdoTimers.App\Controls\ArtImage.xaml.cs" Link="Controls\ArtImage.xaml.cs" />
    <Compile Include="..\..\src\BdoTimers.App\Controls\Ui.cs" Link="Controls\Ui.cs" />
    <Resource Include="..\..\src\BdoTimers.App\Theme\Fonts\Cinzel-Regular.ttf" Link="Theme\Fonts\Cinzel-Regular.ttf" />
    <Resource Include="..\..\src\BdoTimers.App\Assets\app.ico" Link="Assets\app.ico" />
    <Resource Include="..\..\src\BdoTimers.App\Assets\Bosses\garmoth.jpg" Link="Assets\garmoth.jpg" />
    <Resource Include="..\..\src\BdoTimers.App\Assets\Bosses\vell.jpg" Link="Assets\vell.jpg" />
  </ItemGroup>

</Project>
