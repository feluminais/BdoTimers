<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">

  <!-- Per-user like the MSI it chains, so setup never asks for admin rights. -->
  <Bundle Name="BDO Timers" Manufacturer="feluminais" Version="$(var.Version)"
          UpgradeCode="58fc3ca9-2669-43e7-8807-335ec282a4b7"
          IconSourceFile="$(sys.SOURCEFILEDIR)..\..\src\BdoTimers.App\Assets\app.ico">
    <BootstrapperApplication SourceFile="$(var.SetupUiDir)\SetupUi.exe">
      <Payload SourceFile="$(var.SetupUiDir)\SetupUi.exe.config" />
      <Payload SourceFile="$(var.SetupUiDir)\WixToolset.BootstrapperApplicationApi.dll" />
      <Payload SourceFile="$(var.SetupUiDir)\mbanative.dll" />
    </BootstrapperApplication>

    <!-- The folder that gets a BdoTimers folder inside it: InstallRoot=... on the command line (the name's case must
         match), or the setup window's choice. Empty lets the MSI reuse the remembered folder. bal:CommandLineVariables
         isn't used: WiX 5.0.2 writes it in a form its managed API can't read. -->
    <Variable Name="InstallRoot" bal:Overridable="yes" />
    <Variable Name="DeleteData" Type="numeric" Value="0" bal:Overridable="yes" />

    <Chain>
      <MsiPackage Id="BdoTimersMsi" SourceFile="$(var.MsiPath)">
        <MsiProperty Name="INSTALLROOT" Value="[InstallRoot]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
