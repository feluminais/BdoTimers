<Project Sdk="WixToolset.Sdk/5.0.2">

  <!-- The app package. Users run the bundle (../Bundle), which chains this MSI behind the styled setup window. -->
  <PropertyGroup>
    <OutputName>BdoTimers-$(Version)</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- publish.ps1 passes the staged app folder; this default matches its staging path. -->
    <AppDir Condition="'$(AppDir)' == ''">$(MSBuildThisFileDirectory)..\..\obj\publish\app</AppDir>
    <DefineConstants>Version=$(Version);AppDir=$(AppDir)</DefineConstants>
    <!-- ICE38/ICE64/ICE91 assume per-machine layouts, and this is a per-user install into the profile.
         ICE61 flags AllowSameVersionUpgrades, which is deliberate: a rebuild of the same commit has the same version
         and must still replace the installed build. -->
    <SuppressIces>ICE38;ICE61;ICE64;ICE91</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
