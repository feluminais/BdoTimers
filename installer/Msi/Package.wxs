<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!-- Per-user so no admin prompt is needed. A folder that needs admin rights (e.g. Program Files) therefore
       fails with "access denied". Starting with Windows is left to the app's own setting, off by default. -->
  <Package Name="BDO Timers" Manufacturer="feluminais" Version="$(var.Version)" Scope="perUser"
           UpgradeCode="4d02b9b6-670a-4922-b199-abc2d24057de">
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of BDO Timers is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="$(sys.SOURCEFILEDIR)..\..\src\BdoTimers.App\Assets\app.ico" />

    <!-- INSTALLROOT is the folder the user chose; the app always goes into its own BdoTimers folder inside it, so
         choosing an existing folder never spills the app's files into it. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLROOT" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="BdoTimers" />
      </Directory>
    </StandardDirectory>

    <!-- Reinstalls and upgrades reuse the remembered folder unless the bundle passes a new one. A search straight
         into INSTALLROOT would overwrite the passed value, because AppSearch runs after command-line properties. -->
    <Property Id="PREVIOUSINSTALLROOT">
      <RegistrySearch Id="PreviousInstallRoot" Root="HKCU" Key="Software\BdoTimers" Name="InstallRoot" Type="raw" />
    </Property>
    <SetProperty Id="INSTALLROOT" Value="[PREVIOUSINSTALLROOT]" After="AppSearch" Sequence="both"
                 Condition="PREVIOUSINSTALLROOT AND NOT INSTALLROOT" />

    <Feature Id="Main">
      <Files Directory="INSTALLFOLDER" Include="$(var.AppDir)\**" />
      <ComponentRef Id="Shell" />
    </Feature>

    <!-- Registry value as key path because per-user components must not key on files. The app's Data folder is not
         the package's, so RemoveFolder leaves a folder that still holds it; setup only deletes it on explicit request. -->
    <Component Id="Shell" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKCU" Key="Software\BdoTimers" Name="InstallRoot" Type="string" Value="[INSTALLROOT]" KeyPath="yes" />
      <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="BDO Timers" Icon="AppIcon.ico"
                Target="[INSTALLFOLDER]BdoTimers.exe" WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
    </Component>
  </Package>
</Wix>
